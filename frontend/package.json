    "@storybook/addon-vitest": "10.6.0",
    "@storybook/sveltekit": "10.6.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.19.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
