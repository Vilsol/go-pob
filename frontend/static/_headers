# Cloudflare Pages only (GitHub Pages ignores this file). go-pob.wasm.br is the brotli-encoded module;
# served as application/wasm with Content-Encoding: br the browser decodes it while downloading.
# no-transform keeps the edge from encoding it a second time. The page checks the bytes it gets and
# falls back to go-pob.wasm.gz if they are not a wasm module.
/go-pob.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# The service worker script decides which deployment a returning visitor runs, and the manifest is how the app
# installs: neither may be answered from a stale cache (lib/pwa also registers with updateViaCache: 'none').
/service-worker.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Every response, the service worker and the workers included (a worker runs under its own script's policy).
# The full CSP is report-only until the import, share and account flows have run under it. 'unsafe-eval': the
# generated Go bindings build their wrappers with eval. Nothing frames the app; it opens other sites with noopener.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://data.pob.gg https://web.poecdn.com; connect-src 'self' https://data.pob.gg https://api.pob.codes https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
