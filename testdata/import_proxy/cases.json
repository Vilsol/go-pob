{
  "about": "One contract for both import proxies: frontend/src/lib/import_proxy/proxy.test.ts and internal/importproxy/proxy_test.go each run every case against a faked upstream. A body, path or text is a string or {prefix, repeat+count | b64 | code, suffix}; code is url-safe base64 over the zlib-deflated inner spec. upstream defaults to 200 with an empty body; fetch lists every expected upstream request (omitted: unchecked); fetches and cached are counts after the step; a header value null means absent.",
  "constants": {
    "USER_AGENT": "go-pob (+https://pob.gg)",
    "BUILD_CAP": 1048576,
    "LINK_CAP": 1024,
    "POE_CAP": 4194304,
    "IMMUTABLE_TTL": 604800,
    "EDITABLE_TTL": 300,
    "POE_TTL": 60
  },
