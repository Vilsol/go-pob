	// This boot enchant gives a buff that applies both stats individually.
	//
	// Without this row the line falls through to the generic "attack and cast speed" -> Speed
	// name mapping, which produces ONE UNFLAGGED mod — and an unflagged Speed INC matches every
	// cfg, including the ailment and trap/mine configs that carry neither Attack nor Cast.
	// Upstream added it in 12953654f alongside the Adrenaline and Her Embrace splits, which are
	// the same defect reached from the other direction.
	//
	//pob:block:src/Modules/ModParser.lua:4311-4314
	`(\d+)% increased attack and cast speed if you've killed recently`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("Speed", "INC", num).Flag(mod.MFlagCast).Tag(mod.Condition("KilledRecently")),
			MOD("Speed", "INC", num).Flag(mod.MFlagAttack).Tag(mod.Condition("KilledRecently")),
		}, ""
	},
	// Traps, Mines and Totems
