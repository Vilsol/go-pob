	// :5255-5256 and :2017-2029 (dealNoNonDamageType). Fire was the only spelling here, hardcoded,
	// so "Cannot deal non-Cold Damage" and "Cannot deal non-Lightning Damage" were dropped WHOLE.
	//
	// ⚠️ THIS IS AN OVER-APPLICATION FIX, WHICH IS THE CLASS NO MISSING-THING INSTRUMENT SEES. A
	// dropped DealNo flag does not make a number too small, it leaves damage types enabled that the
	// build cannot deal — so `producer-census`, both drop censuses and `task citations` all point
	// the wrong way at it. 1271 corpus builds allocate one of these two nodes.
	//
	// ⚠️ AND THE CAPTURE MUST BE VALIDATED. PoB's dealNoNonDamageType returns NOTHING when the
	// captured word is not a damage type (:2019-2021), which leaves the line unparsed and therefore
	// DROPPED. Returning an empty mod list here has the same effect, so the two agree on nonsense
	// input rather than only on the five real spellings.
	// ⚠️ "elemental" IS NOT A DAMAGE TYPE AND PoB HAS A DEDICATED ROW FOR IT, which this pattern
	// was swallowing. ModParser.lua:5254 is a LITERAL key `["deal no non%-elemental damage"]` and
	// Lua matches literal keys before patterns, so the generic at :5255 never sees it. Our engine
	// has no such precedence: this regex matched first, the handler found "Elemental" was not a
	// damage type, returned nil — and a MATCHED row returning nil drops the line, so the literal
	// row below (which has existed all along) could never run. It read as a missing row and was
	// really a shadowed one.
	//
	// ⚠️ THE SPELLING MATTERS AND THE ASYMMETRY IS UPSTREAM'S. PoB's literal exists only for
	// "deal no"; "cannot deal non-elemental damage" hits :5256's pattern, returns nothing and IS
	// dropped. So the special case is gated on the prefix rather than applied to both, which is
	// why this captures the prefix instead of using a non-capturing group.
	`(cannot deal|deal no) non\-(\w+) damage`: func(num float64, captures []string) ([]mod.Mod, string) {
		// ⚠️ CAPTURES KEEP THE LINE'S ORIGINAL CASE. The regexes match case-insensitively but the
		// captured text is verbatim, so a case-SENSITIVE compare here passed on
		// "deal no non-elemental damage" and failed on the real item text
		// "Deal no Non-Elemental Damage" — the spelling the fixture actually carries. Measured
		// both ways before this line was written; the lowercase form parsed and the shipped one
		// did not, which is what named the cause.
		if strings.EqualFold(captures[1], "elemental") {
			if !strings.EqualFold(captures[0], "deal no") {
				return nil, ""
			}
			//pob:src/Modules/ModParser.lua:5254
			return []mod.Mod{mod.NewFlag("DealNoPhysical", true), mod.NewFlag("DealNoChaos", true)}, ""
		}
		want := data.DamageType(firstToUpper(captures[1]))
		known := false
		for _, dt := range data.DamageType("").Values() {
			if dt == want {
				known = true
				break
			}
		}
		if !known {
			return nil, ""
		}
		out := make([]mod.Mod, 0, 4)
		for _, dt := range data.DamageType("").Values() {
			if dt != want {
				out = append(out, mod.NewFlag("DealNo"+string(dt), true))
			}
		}
		return out, ""
	},
	// :3811-3812. The Cold Mastery pair, found by TestTreeStatParseCensus once it was widened to
	// read MasteryEffects[].Stats. ⚠️ THE LIMIT IS A QUOTIENT, NOT THE PRINTED MAXIMUM: PoB writes
	// `limit = limit / num`, so "5% per second, up to 50%" caps the MULTIPLIER at 10 seconds rather
	// than capping the modifier at 50.
	`enemies permanently take (\d+)% increased damage for each second they've ever been frozen by you, up to a maximum of (\d+)%`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{mod.NewList("EnemyModifier", mod.EnemyModifier{Mod: mod.NewFloat("DamageTaken", mod.TypeIncrease, num).
			Tag(mod.Condition("FrozenByYou")).
			Tag(mod.Multiplier("FrozenByYouSeconds").Limit(utils.Float(captures[1]) / num))})}, ""
	},
	`enemies permanently take (\d+)% increased damage for each second they've ever been chilled by you, up to a maximum of (\d+)%`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{mod.NewList("EnemyModifier", mod.EnemyModifier{Mod: mod.NewFloat("DamageTaken", mod.TypeIncrease, num).
			Tag(mod.Condition("ChilledByYou")).
			Tag(mod.Multiplier("ChilledByYouSeconds").Limit(utils.Float(captures[1]) / num))})}, ""
	},
	// :3070-3073. TWO mods: the minion copy carries the parent's reservation through
	// PerStat.actor="parent", and the player's own copy reads its own.
	`herald skills and minions from herald skills deal (\d+)% more damage for every (\d+)% of maximum life those skills reserve`: func(num float64, captures []string) ([]mod.Mod, string) {
		per := utils.Float(captures[1])
		return []mod.Mod{
			mod.NewList("MinionModifier", mod.MinionModifier{Mod: mod.NewFloat("Damage", mod.TypeMore, num).
				Tag(mod.PerStat(per, "LifeReservedPercent").Actor("parent"))}).
				Tag(mod.SkillType(string(data.SkillTypeHerald))),
			mod.NewFloat("Damage", mod.TypeMore, num).
				Tag(mod.PerStat(per, "LifeReservedPercent")).
				Tag(mod.SkillType(string(data.SkillTypeHerald))),
		}, ""
	},
	// :2897. `ArcaneSurgeDamage` already had a consumer and no producer.
	`arcane surge a?l?s?o? ?grants (\d+)% more spell damage to you`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("ArcaneSurgeDamage", "MAX", num)}, ""
	},
	// :3822-3824 and :2829. The four chill-effect flags CalcPerform.lua:3438-3449 reads. All four
	// were absent, so the whole elseif chain there was unreachable and only the Bonechill fallback
	// could ever fire.
	//
	// ⚠️ THIS IS WHERE A 12% MULTIPLIER WENT MISSING ON 927 BUILDS. On
	// 0075-elementalist-winter-orb every damage key is wrong by exactly 0.89081, every mod matches
	// PoB's, and the gap is entirely in ColdEffMult (ours 1.28, PoB 1.4336 — exactly x1.12). PoB's
	// enemy carried `ColdDamageTaken INC 12` sourced "Chilled by Hits"; ours carried nothing,
