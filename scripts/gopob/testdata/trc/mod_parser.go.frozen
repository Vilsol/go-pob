	"of aura skills":                   {tag: mod.SkillType(string(data.SkillTypeAura))},
	//pob:block:src/Modules/ModParser.lua:1033-1034
	// ⚠️ THERE IS DELIBERATELY NO "of retaliation skills" ROW HERE. PoB has "by retaliation
	// skills" (:1026) and "^retaliation skills have/deal " (:1227) and NOTHING for the "of" form,
	// so "100% increased Cost Efficiency of Retaliation Skills" leaves leftover Extra in PoB too
	// and is dropped by both sides. Porting the absence is the point; adding the row would make
	// us compute a modifier the oracle does not.
	"link skills":                  {tag: mod.SkillType(string(data.SkillTypeLink))},
