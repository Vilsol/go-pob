	`damage penetrates fire resistance equal to your overcapped fire resistance`: []mod.Mod{
		mod.NewFlag("FirePenIncreasedByUncappedFireRes", true),
	},
	`damage penetrates fire resistance equal to your overcapped fire resistance, up to a maximum of (\d+)%`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("FirePenetration", "BASE", 1).
			Tag(mod.PerStat(1, "FireResistOverCap").Limit(num).LimitTotal(true))}, ""
	},
	// ModCache.lua:9967. ⚠️ TWO MODS, and the second is what makes the first's GLOBAL LIMIT bind:
	// the MORE carries globalLimit 100 keyed on ActiveGolemLimitDoubledLimit, and the OVERRIDE
	// publishes the multiplier that key counts. Porting only the MORE leaves the cap unreachable.
	`maximum number of summoned golems is doubled`: []mod.Mod{
		MOD("ActiveGolemLimit", "MORE", 100).
			Tag(mod.Multiplier("ActiveGolemLimitDoubled").GlobalLimit(100).GlobalLimitKey("ActiveGolemLimitDoubledLimit")),
		MOD("Multiplier:ActiveGolemLimitDoubled", "OVERRIDE", 1),
	},
	`maximum number of raised spectres is doubled`: []mod.Mod{
		MOD("ActiveSpectreLimit", "MORE", 100).
			Tag(mod.Multiplier("ActiveSpectreLimitDoubled").GlobalLimit(100).GlobalLimitKey("ActiveSpectreLimitDoubledLimit")),
		MOD("Multiplier:ActiveSpectreLimitDoubled", "OVERRIDE", 1),
	},
	// ⚠️ THESE TWO ARE THE SAME SHAPE AGAIN, AND THAT REPETITION IS THE POINT: upstream has NO
	// per-line rows for any of them. ModParser.lua:155-157 maps `is doubled` / `doubles?` /
	// `causes? double` to a DOUBLED **form**, and :6791-6806 expands ANY mod name into exactly this
	// pair. Every row here is that form, unrolled by hand for one name.
	//
	// ⚠️ THE FORM IS NOW PORTED (formList's three DOUBLED rows and parseMod's DOUBLED case), so
	// these four rows are no longer the only definition — they are a SHADOW of it, because
	// specialModList is scanned before the form list and returns early. They are kept only
	// because deleting them is a behaviour change that needs its own measurement, not because
	// they are still needed. TestDoubledFormExpandsAnyModName uses the golem line as its control
	// precisely so that equivalence is asserted rather than assumed.
	//
	// ⚠️ AND THE WORKLIST IS BIGGER THAN THESE FOUR: `grep -n "is doubled" mod_parser.go` finds
	// ELEVEN more hand-unrolled rows (evasion vs melee/projectile, the six leech-rate lines,
	// both block chances, accuracy, chaos resistance) and NONE of them emits the OVERRIDE half,
	// so each one applies its MORE 100 with no global limit to cap it. They are not all
	// mechanical deletions: `evasion rating is doubled against melee attacks` resolves through
	// the form to `Evasion` plus a tag, not to `MeleeEvasion`, so the form's answer must be
	// compared against PoB's per line before any row is removed.
	//
	// Populations: 82 corpus builds carry the phantasm line, 58 the energy-shield leech one.
	`maximum number of summoned phantasms is doubled`: []mod.Mod{
		MOD("ActivePhantasmLimit", "MORE", 100).
			Tag(mod.Multiplier("ActivePhantasmLimitDoubled").GlobalLimit(100).GlobalLimitKey("ActivePhantasmLimitDoubledLimit")),
		MOD("Multiplier:ActivePhantasmLimitDoubled", "OVERRIDE", 1),
	},
	`maximum recovery per energy shield leech is doubled`: []mod.Mod{
		MOD("MaxEnergyShieldLeechInstance", "MORE", 100).
			Tag(mod.Multiplier("MaxEnergyShieldLeechInstanceDoubled").GlobalLimit(100).GlobalLimitKey("MaxEnergyShieldLeechInstanceDoubledLimit")),
		MOD("Multiplier:MaxEnergyShieldLeechInstanceDoubled", "OVERRIDE", 1),
	},
	// :3014-3021. Heartstopper (tree node 28884, 13 corpus builds).
	//
	// ⚠️ THE NAME IS `DamageTakenWhenHit`, NOT `DamageTaken`, AND THERE ARE TWO MODS PER LINE.
	// Before this we emitted a single `DamageTaken MORE -50` from a looser row, which is a
	// different output key read by a different term: PoB's <T>SpellTakenHitMult and
	// <T>AttackTakenHitMult are built from DamageTakenWhenHit (CalcDefence.lua:1890-1902), so ours
	// read 1 where PoB read 0.75 and PhysicalTakenHit came out at exactly 4/3 of PoB's.
	//
	// The second mod is the AVERAGE arm: -num * duration / 10, because the buff is up for
	// `duration` seconds out of every 10.
	`take (\d+)% less damage from hits for (\d+) seconds`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("DamageTakenWhenHit", "MORE", -num).Tag(mod.Condition("HeartstopperHIT")),
			MOD("DamageTakenWhenHit", "MORE", -num*utils.Float(captures[1])/10).Tag(mod.Condition("HeartstopperAVERAGE")),
		}, ""
	},
	`take (\d+)% less damage over time for (\d+) seconds`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("DamageTakenOverTime", "MORE", -num).Tag(mod.Condition("HeartstopperDOT")),
			MOD("DamageTakenOverTime", "MORE", -num*utils.Float(captures[1])/10).Tag(mod.Condition("HeartstopperAVERAGE")),
		}, ""
	},
	// :4843. 2142 corpus builds carry this flask line; `CorruptedBloodImmune` had a consumer.
	`grants immunity to corrupted blood for (\d+) seconds if used while affected by corrupted blood`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{mod.NewFlag("CorruptedBloodImmune", true).Tag(mod.Condition("UsingFlask"))}, ""
	},
	// :5617-5621. Both cost conversions; both names already had consumers here.
	`skills gain a base life cost equal to (\d+)% of base mana cost`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("ManaCostAsLifeCost", "BASE", num)}, ""
	},
	`skills gain a base energy shield cost equal to (\d+)% of base mana cost`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("ManaCostAsEnergyShieldCost", "BASE", num)}, ""
	},
	`you take (\d+)% reduced extra damage from critical strikes while you have no power charges`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("ReduceCritExtraDamage", "BASE", num).Tag(mod.StatThreshold("PowerCharges", 0).Upper(true)),
		}, ""
	},
	`you take (\d+)% reduced extra damage from critical strikes by poisoned enemies`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("ReduceCritExtraDamage", "BASE", num).Tag(mod.ActorCondition("enemy", "Poisoned"))}, ""
	},
	`nearby allies have (\d+)% chance to block attack damage per (\d+) strength you have`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("ExtraAura", "LIST", mod.ExtraAura{OnlyAllies: true, Mod: mod.NewFloat("BlockChance", mod.TypeBase, num)}).Tag(mod.PerStat(utils.Float(captures[1]), "Str"))}, ""
	},
}

// Immediately after the specialModList literal, every keystone name becomes a mod line of its own:
//
//	for _, name in ipairs(data.keystones) do
//		specialModList[name:lower()] = { mod("Keystone", "LIST", name),
//			flag("Condition:Have"..firstToUpper(name):gsub(" %l", string.upper):gsub(" ", "")) }
//	end
//
// This runs in its own init so it happens after the map literal but before initializeRegex
// compiles it. PoB's follow-up loop, which rewraps every key as "^"..k.."$", has no counterpart
// here: initializeRegex already anchors specialModList keys when it compiles them.
//
// ⚠️ THE `Condition:Have<Name>` HALF WAS MISSING FOR EVERY KEYSTONE IN THE GAME, so anything gated
// on "while you have <Keystone>" evaluated false on every build in the corpus. This is not one
// keystone unported; it is the whole class.
//
// ⚠️ AND THE CITATION THAT USED TO SIT HERE IS WHY IT SURVIVED. It quoted upstream's OLDER
// two-line form exactly, which was faithful when it was written; PoB then added the flag and the
// marker was never re-derived. A `//pob:` marker is a DRIFT DETECTOR — the signal is that it stops
// matching, and a marker quoting stale code in prose defeats its own purpose.
//
//pob:block:src/Modules/ModParser.lua:5878-5880
func init() {
	for _, name := range data.Keystones {
		specialModList[strings.ToLower(name)] = []mod.Mod{
			MOD("Keystone", "LIST", name),
			mod.NewFlag("Condition:Have"+keystoneConditionSuffix(name), true),
		}
	}

	// ModParser.lua:5881-5883 is a SECOND loop over the cluster-jewel keystones, and it had no
	// counterpart here at all -- so the eight names below parsed to nothing and a build granting
	// one got no Keystone mod. 111 build-mentions in the corpus across four of the eight.
	//
	// ⚠️ IT DELIBERATELY DOES NOT SET Condition:Have. The loop above does and this one does not,
	// one line apart upstream, so the asymmetry is the port -- copying the first loop's body here
	// would be the natural thing to write and would be wrong. Porting fidelity means porting the
	// ABSENCES too, which is why the test asserts the flag is NOT set.
	//
	// It runs SECOND, so a name in both lists would lose its flag. None of the eight is also one
	// of the 58 at this pin, so the overwrite is inert today -- kept in upstream order rather than
	// merged, because which loop wins is the kind of thing a data change can make matter.
	//
	//pob:block:src/Modules/ModParser.lua:5881-5883
	for _, name := range data.ClusterJewels.Keystones {
		specialModList[strings.ToLower(name)] = []mod.Mod{
			MOD("Keystone", "LIST", name),
		}
	}
}

// keystoneConditionSuffix is `firstToUpper(name):gsub(" %l", string.upper):gsub(" ", "")`.
//
// ⚠️ THE LUA UPPERCASES THE CHARACTER AFTER A SPACE ONLY WHEN IT IS LOWERCASE (`%l`), then removes
// the spaces. Uppercasing unconditionally is equivalent — on an already-capitalised word it is a
// no-op — and it is written that way here because the two-character match is what makes the Lua
// non-obvious, not the intent. Every other character is carried through untouched, so a keystone
// whose name gains punctuation still round-trips.
func keystoneConditionSuffix(name string) string {
	r := []rune(firstToUpper(name))
	for i := 0; i+1 < len(r); i++ {
		if r[i] == ' ' {
			r[i+1] = unicode.ToUpper(r[i+1])
		}
	}
	return strings.ReplaceAll(string(r), " ", "")
}

