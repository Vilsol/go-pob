	"ward does not break during f?l?a?s?k? ?effect": []mod.Mod{
		FLAG("WardNotBreak").Tag(mod.Condition("UsingFlask")),
		FLAG("Condition:UnbrokenWard").Tag(mod.Condition("UsingFlask")),
	},
