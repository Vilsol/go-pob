	"with ailments":                    {flags: mod.MFlagAilment},
	"with ailments from attack skills": {flags: mod.MFlagAilment, keywordFlags: mod.KeywordFlagAttack},
	"with poison":                      {keywordFlags: mod.KeywordFlagPoison},
