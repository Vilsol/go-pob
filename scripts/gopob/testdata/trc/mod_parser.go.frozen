	// ModParser.lua:3069, the Lycia ascendancy node "Farewell to Flesh". A MORE scaled by a PerStat
	// with a divisor, which is why the prefix row `^herald skills have ` cannot cover it: that
	// strips the subject and tags the skill type, but the remainder still needs its own pattern.
	`herald skills have (\d+)% more buff effect for every (\d+)% of maximum mana they reserve`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("BuffEffect", "MORE", num).
				Tag(mod.PerStat(utils.Float(captures[1]), "ManaReservedPercent")).
				Tag(mod.SkillType(string(data.SkillTypeHerald))),
		}, ""
	},
