	// PLAIN ONE DID NOT — the same shape as the Determination arm of ReduceCritExtraDamage. A
	// family with most of its arms present reads as covered.
	`increases and reductions to cast speed apply to attack speed`: []mod.Mod{
		mod.NewFlag("CastSpeedAppliesToAttacks", true),
	},
