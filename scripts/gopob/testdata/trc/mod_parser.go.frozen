	"historic": []mod.Mod{},
	// --- Journey Tattoos (ModParser.lua:5800-5812) -------------------------------------------
	//
	// The whole family was absent: `grep -c tattoo` over this file returned 3, all inside one
	// comment, and zero rows. Each line is SELF-CONTAINED — it emits the stat mod AND the
	// Multiplier the stat mod's own tag reads — so the multiplier is its own producer and the tag
