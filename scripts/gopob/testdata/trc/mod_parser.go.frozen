	// PoB ModParser.lua:2220-2234. The character class is Lua's `[%a+]*` -- letters or a
	// literal '+' -- which covers "socketed skill gems", "socketed attack gems" and the bare
	// "socketed gems". PoB's function returns nil when the gem name does not resolve, leaving
	// the line unparsed; returning a nil mod list here does the same.
	`socketed [\w+]* ?gems a?r?e? ?supported by level (\d+) (.+)`: func(num float64, captures []string) ([]mod.Mod, string) {
		entries := extraSupportIDsForName(captures[1])
		if len(entries) == 0 {
			return nil, ""
		}
		return extraSupportMods(entries, int(num), "{SlotName}"), ""
	},
	// ⚠️ THE HELPER AND THE CONSUMER WERE ALREADY HERE; ONLY THIS ROW WAS MISSING. The sibling
	// above -- "socketed gems are supported by level N X" -- has used extraSupportIDsForName all
	// along. This one names a DIFFERENT slot, and a dropped line costs the build an entire support
	// gem on every skill in that slot, so it is a damage defect rather than a display one. 225
	// corpus builds carry one, across 108 distinct shapes.
	//
	// ⚠️ `num` IS THE FIRST CAPTURE AND THE FIRST CAPTURE HERE IS THE SLOT, NOT THE LEVEL. The
	// level is read from captures[1] explicitly; taking `num` would silently grant every one of
	// these supports at level 0.
	//pob:src/Modules/ModParser.lua:3374
	`skills socketed in your (.+) are supported by level (\d+) (.+)`: func(num float64, captures []string) ([]mod.Mod, string) {
		entries := extraSupportIDsForName(captures[2])
		if len(entries) == 0 {
			return nil, ""
		}
		return extraSupportMods(entries, int(utils.Float(captures[1])), extraSupportSlotName(captures[0])), ""
	},
	`socketed support gems can also support skills from your ([\w\s]+)`: func(num float64, captures []string) ([]mod.Mod, string) {
		targetItemSlotName := "Body Armour"
		// PoB's scan() captures out of `lineLower` (ModParser.lua:3952-3962), so this handler
		// (:2236-2240) always compares against lowercase. go-pob's scanState.result() slices the
		// ORIGINAL-case line, so the item text "... from your Main Hand" fell through to the
		// "Body Armour" default and every LinkedSupport in the corpus cross-linked to the wrong
		// slot.
		if strings.EqualFold(captures[0], "main hand") {
			targetItemSlotName = "Weapon 1"
		}
		return []mod.Mod{
			MOD("LinkedSupport", "LIST", mod.LinkedSupport{TargetSlotName: targetItemSlotName}).Tag(mod.SocketedIn("{SlotName}")),
		}, ""
	},
	"socketed hex curse skills are triggered by doedre's effigy when summoned": []mod.Mod{MOD("ExtraSupport", "LIST", mod.ExtraSupport{SkillID: "SupportCursePillarTriggerCurses", Level: 20}).Tag(mod.SocketedIn("{SlotName}"))},
	`trigger level (\d+) (.+) every (\d+) seconds`: func(num float64, captures []string) ([]mod.Mod, string) {
		return triggerExtraSkill(captures[1], int(num), false, ""), ""
	},
	`trigger level (\d+) (.+), (.+) or (.+) every (\d+) seconds`: func(num float64, captures []string) ([]mod.Mod, string) {
