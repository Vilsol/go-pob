	// ⚠️ THE ONLY MOD LINES IN THE GAME THAT CAN TELL TWO GEMS IN ONE ITEM APART. Both are
	// Dialla's Malefaction, whose sockets are G-R-R-G-G-G on the corpus build that named this:
	// Empower and Enhance sit in the two RED sockets and the active gem does not, so the +2
	// reaches the SUPPORTS only — and Empower at level 6 grants +5 to the skill it supports
	// where Empower at 4 grants +3. Two rungs, one mod line.
	//
	// Without these rows the line was UNPARSED, which discards it whole; minion level is
	// activeEffect.grantedEffectLevel.levelRequirement and indexes every minion table, so the
	// shortfall moved life, armour, evasion and damage together. `task corpus-grep
	// PATTERN='Sockets have'` puts the family on 147 of 8648 builds.
	//
	// ⚠️ PoB HARDCODES THE COLOUR PER ROW AND SO DOES THIS. Red carries level and green carries
	// quality because those are the only two lines that exist; a generalised
	// `socketed in (\w+) sockets` row would parse text PoB does not, which is a divergence in
	// the direction no instrument here looks.
	//
	// ⚠️ AND THE SIGN IS OUTSIDE THE CAPTURE, WHICH IS UPSTREAM'S. ModParser.lua:3238 is
	// `[%+%-](%d+)`, not `([%+%-]%d+)` as the plain "to level of socketed gems" row two entries
	// above is — so a hypothetical "-2 to Level" would read as +2 there too. Kept identical
	// rather than corrected: no such line exists, and diverging here would be silent.
	//
	//pob:src/Modules/ModParser.lua:3238-3239
	`gems socketed in red sockets have [\+\-](\d+) to level`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("all"), Key: "level", Value: num}).Tag(mod.SocketedIn("{SlotName}").SocketColor("R"))}, ""
	},
	`gems socketed in green sockets have [\+\-](\d+)% to quality`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("all"), Key: "quality", Value: num}).Tag(mod.SocketedIn("{SlotName}").SocketColor("G"))}, ""
	},
	// ⚠️ ModParser.lua:2364 IS THE THIRD socketColor ROW — blue sockets, attribute requirements —
	// and it is deliberately absent: its GemProperty key is "req", and
	// applyGemProperty (env.go) stores only "level" and "quality" because GemEffect has no `req`
	// field and PoB's consumer for it — `gemInstance.reqOverride` (CalcSetup.lua:1603, :1673) —
	// is unported. Adding the row alone would parse the line and drop the value, which reads as
	// support. The condition that retires this: a `Req` field on GemEffect with a reader.
	//
	// ⚠️ ITS KEY IS DESCRIBED HERE AND DELIBERATELY NOT QUOTED. `table-row-census` scrapes the
	// string literals of THIS FILE and compares them against the pin's table keys; it cannot tell
	// a key from prose, so writing that row's text in a comment made the census report it as
	// PORTED. Measured: 928 -> 925 with the phrase, 928 -> 926 without it, against two rows
	// actually added. A comment that quotes what an instrument greps for edits the measurement.
	`\+(\d+)% to quality of all skill gems`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("active_skill"), Key: "quality", Value: num})}, ""
	},
	`\+(\d+)% to quality of socketed ([\w ]+) gems`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr(captures[1]), Key: "quality", Value: num}).Tag(mod.SocketedIn("{SlotName}"))}, ""
	},
	`\+(\d+) to level of active socketed skill gems`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("active_skill"), Key: "level", Value: num}).Tag(mod.SocketedIn("{SlotName}"))}, ""
	},
	`\+(\d+) to level of socketed active skill gems`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("active_skill"), Key: "level", Value: num}).Tag(mod.SocketedIn("{SlotName}"))}, ""
	},
	`\+(\d+) to level of socketed active skill gems per (\d+) player levels`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr("active_skill"), Key: "level", Value: num}).Tag(mod.SocketedIn("{SlotName}")).Tag(mod.Multiplier("Level").Div(utils.Float(captures[1])))}, ""
	},
