// Build active skill name lookup
var skillNameListCompiled map[string]CompiledList[modNameListType]
var preSkillNameListCompiled map[string]CompiledList[modNameListType]

// initializeSkillNameList builds the per-skill name patterns from the gem list: the
// " <name> " infix form, the four "^<name> …" prefix forms, and the totem/buff/aura
// variants. The specialModList half of the same Lua loop is addSkillSpecial below.
//
// It is a func rather than a package var because it needs the game data loaded, which is
// why the init at the foot of this file registers it as a post-init hook.
//
//pob:block:src/Modules/ModParser.lua:4124-4149
func initializeSkillNameList() {
	skillNameListCompiled = make(map[string]CompiledList[modNameListType])
	skillNameListCompiled[" corpse cremation "] = CompiledList[modNameListType]{
		Regex: regexp.MustCompile(` corpse cremation `),
		Value: modNameListType{
			tag: mod.SkillName("Cremation"),
		},
	}

	preSkillNameListCompiled = make(map[string]CompiledList[modNameListType])
	for _, gemData := range poe.SkillGems {
		// ModParser.lua:3578 iterates `pairs(data.gems)` — PoB's OWN hand-maintained
		// src/Data/Gems.lua, ported as raw2.Gems. poe.SkillGems is go-pob-data's full dat
		// extract and is strictly LARGER: 33 active-skill names live there and nowhere in PoB
		// (measured over the loop's own output), each contributing an infix " <name> " and
		// four-plus "^<name> …" patterns PoB does not have. Several are ordinary English words
		// — Ignite, Envy, Snipe, Riptide, Wildfire, Backstab — so a mod line picked up a
		// SkillName tag PoB never applies. Same shape as the minion skill-list defect.
		pobGemEntry, inPoB := raw2.Gems[gemBaseID(gemData)]
		if !inPoB {
			continue
		}
		// ⚠️ RESOLVED BY ID THROUGH PoB'S OWN TABLE, NOT BY gemData.GetGrantedEffect().
		//
		// poe.SkillGem.GrantedEffect is a NON-POINTER int decoded from "GrantedEffectsKey",
		// and go-pob-data does not populate it: the accessor is the slice index
		// `GrantedEffects[s.GrantedEffect]`, so a zero field returns ELEMENT 0 -- Fireball --
		// for ALL 847 skill gems. Measured: `gem -> GetGrantedEffect() -> GetActiveSkill()`
		// yielded exactly ONE distinct DisplayedName across every gem. So this whole loop
		// built its patterns for one skill and overwrote them 847 times, leaving the entire
		// skillNameList/preSkillNameList namespace populated by Fireball alone.
		//
		// Same family as the GrantedEffectStatSets defect (every skill read Fireball's stat
		// set, worth +36977) and it hides the same way: no error, no nil, a plausible object.
		// raw2.Gems IS PoB's src/Data/Gems.lua, which is what ModParser.lua:6042 iterates, and
		// its GrantedEffectID is a STRING key -- 345 distinct active skills resolve through it.
		grantedEffect := poe.GrantedEffectByID(pobGemEntry.GrantedEffectID)
		// ModParser.lua:6044 is `not grantedEffect.hidden and not grantedEffect.support`. Only the
		// support half is tested here, and the hidden half is NOT a gap that can move anything.
		//
		// ⚠️ THE REASON WRITTEN HERE HAD EXPIRED AND THE CONCLUSION SURVIVED IT. It said the
		// conjunct was "NOT implementable as written: go-pob-data's GrantedEffects schema has no
		// hidden field". That was true while the loop read go-pob-data; it stopped being true when
		// raw.PoBSkills landed, which is PoB's own table and carries Hidden on all 653 of its
		// hidden rows -- and buildGemLookup in this same file already reads that field. A reader
		// meeting the old note had no way to tell a live constraint from a lapsed one.
		//
		// ⚠️ AND THE OMISSION IS INERT ANYWAY, WHICH IS THE STRONGER ANSWER. Measured over PoB's
		// own gem table: 345 non-support gems reach this loop and 0 of them are hidden, so adding
		// the conjunct cannot change one pattern this loop builds. "Provably cannot matter on this
		// data" beats "cannot be expressed", and it is a different claim -- the first is checkable
		// and the second was wrong.
		//
		// RETIRING CONDITION: TestSkillNameLoopHasNoHiddenGems fails if that count stops being 0.
		// It is a data question, so it is asked of the data rather than asserted here.
		// ⚠️ THE ActiveSkill NIL CHECK IS LOAD-BEARING NOW AND WAS NOT BEFORE. While every gem
		// resolved to Fireball the accessor could not return nil, so the deref below was safe by
		// accident. Resolving properly, 263 of 608 PoB gems have no active skill (the supports).
		if grantedEffect != nil && !grantedEffect.IsSupport && grantedEffect.GetActiveSkill() != nil {
			skillName := grantedEffect.GetActiveSkill().DisplayedName

			if skillName == "" || skillName == "..." || strings.Contains(skillName, "NOT CURRENTLY USED") || strings.Contains(skillName, "UNUSED") {
				continue
			}

			skillNameLower := strings.ToLower(skillName)

			val := modNameListType{
				tag: mod.SkillName(skillName),
			}

			skillNameListCompiled[" "+skillNameLower+" "] = CompiledList[modNameListType]{
				Regex: regexp.MustCompile(" " + skillNameLower + " "),
				Value: val,
			}

			// ModParser.lua:3583 — the BARE prefix, for a line that names the skill and then
			// goes straight into the stat ("wrath 45% increased aura effect"). It is far more
			// general than the four siblings below and matches every line they do; scan
			// resolves that the way PoB does, preferring the LONGEST match and then the longest
			// pattern (:3955, ported at consider() below), so the specific forms still win.
			preSkillNameListCompiled["^"+skillNameLower+" "] = CompiledList[modNameListType]{
				Regex: regexp.MustCompile("^" + skillNameLower + " "),
				Value: val,
			}

			preSkillNameListCompiled["^"+skillNameLower+" has ?a? "] = CompiledList[modNameListType]{
				Regex: regexp.MustCompile("^" + skillNameLower + " has ?a? "),
				Value: val,
			}

			preSkillNameListCompiled["^"+skillNameLower+" deals "] = CompiledList[modNameListType]{
				Regex: regexp.MustCompile("^" + skillNameLower + " deals "),
				Value: val,
			}

			preSkillNameListCompiled["^"+skillNameLower+" damage "] = CompiledList[modNameListType]{
				Regex: regexp.MustCompile("^" + skillNameLower + " damage "),
				Value: val,
			}

			// ModParser.lua:3587-3590. gemData.tags is PoB's src/Data/Gems.lua tag set, ported as
			// raw2.Gems — see the note at the addSkillSpecial call below for why
			// poe.SkillGem.GetTags() cannot stand in for it.
			//
			// The "totem grants " arm is what parses the crafted helmet enchant
			// `Ancestral Protector Totem grants 18% increased Attack Speed while Active`.
			pobGem := raw2.Gems[gemBaseID(gemData)]
			if pobGem.Tags["totem"] {
				preSkillNameListCompiled["^"+skillNameLower+" totem deals "] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("^" + skillNameLower + " totem deals "),
					Value: val,
				}

				preSkillNameListCompiled["^"+skillNameLower+" totem grants "] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("^" + skillNameLower + " totem grants "),
					Value: modNameListType{
						addToSkill: mod.SkillName(skillName),
						tag:        mod.GlobalEffect("Buff"),
					},
				}
			}

			// ModParser.lua:6063-6065, the CURSE arm, is deliberately not ported. It would add
			// one skillNameList row per curse gem producing a Condition:SelfCast<Name> tag.
			//
			// ⚠️ THE REASON WRITTEN HERE UNTIL 2026-08-30 WAS THE WRONG ONE, AND ITS RETIRING
			// CONDITION HAD ALREADY EXPIRED. It said "nothing in this tree READS a condition of
			// that shape". A read is exactly what a tag is, and there is one: the corpus dumps
			// carry `CurseImmune|FLAG|type=Condition/var=SelfCastDespair` on Balance of Terror
			// builds, and its consumer (calc_defence.go's CurseAvoidChance) is ported. So the
			// stated grep would have retired this the moment it was run.
			//
			// The arm is still correctly unported, for a DIFFERENT reason one rung further out:
			// nothing SETS a condition of that shape. CalcPerform.lua:2603 writes
			// `modDB.conditions["SelfCast"..buff.name]` in the curse-application loop and has no
			// counterpart here, so every such tag evaluates false and every mod carrying one is
			// inert. Reading and setting are different questions and only the second decides
			// whether this arm can be worth anything.
			//
			// ⚠️ AND THE PHRASE THIS ARM IS BLAMED FOR IS NOT ITS PHRASE. Measured through
			// oracle/mod_parse.lua against the pin: "Immune to Curses if you've cast Despair in
			// the past 10 seconds" parses WHOLE into CurseImmune, and so does the same line with
			// FIREBALL -- not a curse gem, so this arm cannot be what handles it. The row that
			// does is the generic ModParser.lua:4891, also unported, and it is gated on the same
			// unset condition. 243 of 8648 corpus builds carry an "in the past 10 seconds" line.
			//
			// RETIRING CONDITION: calc_perform.go gaining CalcPerform.lua:2603. Port this arm,
			// ModParser.lua:4888 and ModParser.lua:4891 in that same change -- porting any of
			// them earlier measures exactly zero, which reads identically to a wrong theory.

			// ModParser.lua:3591 reads `grantedEffect.baseFlags.buff` — PoB's hand-written
			// per-skill flag, ported as raw.SkillBaseFlags. This used to test
			// poe.SkillFlagBuffs, which is a different flag ("buffs" is env.modeBuffs) and is
			// never set by go-pob-data's ActiveSkillTypes-derived guess. SmokeMine is the one
			// gem that carries baseFlags.buff without SkillType.Buff.
			if slices.Contains(grantedEffect.GetActiveSkill().ActiveSkillTypes, poe.ActiveSkillTypesByID["Buff"].Key) ||
				slices.Contains(raw2.SkillBaseFlags[grantedEffect.ID], "buff") {
				preSkillNameListCompiled["^"+skillNameLower+" grants "] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("^" + skillNameLower + " grants "),
					Value: modNameListType{
						addToSkill: mod.SkillName(skillName),
						tag:        mod.GlobalEffect("Buff"),
					},
				}

				preSkillNameListCompiled["^"+skillNameLower+" grants a?n? ?additional "] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("^" + skillNameLower + " grants a?n? ?additional "),
					Value: modNameListType{
						addToSkill: mod.SkillName(skillName),
						tag:        mod.GlobalEffect("Buff"),
					},
				}
			}

			// go-pob-data does not populate the gem-type tag set PoB reads as
			// gemData.tags.aura/.herald, but the same distinction is carried by the
			// granted effect's active skill types (Aura=38, Herald=51).
			//
			// ⚠️ THIS PREDICATE IS CORRECT AND WAS NEVER THE DEFECT, THOUGH IT LOOKED LIKE IT.
			// Until the granted-effect resolution above was fixed it saw Fireball's skill types
			// for every gem and fired for none, so all 52 aura/herald gems went without a
			// `while affected by` pattern and every Watcher's Eye line was dropped whole.
			// Rewriting it to read raw2.Gems tags instead MEASURED EXACTLY ZERO: both forms
			// select the same 41 gems. CORRECT CONSUMER, STARVED PRODUCER -- the file where a
			// value is read is rarely the file where it is wrong.
			if slices.Contains(grantedEffect.GetActiveSkill().ActiveSkillTypes, poe.ActiveSkillTypesByID["Aura"].Key) ||
				slices.Contains(grantedEffect.GetActiveSkill().ActiveSkillTypes, poe.ActiveSkillTypesByID["Herald"].Key) {
				affectedBy := modNameListType{
					tag: mod.Condition("AffectedBy" + strings.ReplaceAll(skillName, " ", "")),
				}

				skillNameListCompiled["while affected by "+skillNameLower] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("while affected by " + regexp.QuoteMeta(skillNameLower)),
					Value: affectedBy,
				}

				skillNameListCompiled["while using "+skillNameLower] = CompiledList[modNameListType]{
					Regex: regexp.MustCompile("while using " + regexp.QuoteMeta(skillNameLower)),
					Value: affectedBy,
				}
			}

			// ModParser.lua:3599-3622. gemData.tags is PoB's src/Data/Gems.lua tag set, ported
			// as raw2.Gems -- the same source calcLib.gemIsType reads (calc_tools.go:59).
			// poe.SkillGem.GetTags() is NOT it (those are drop tags), and the
			// ActiveSkillTypes substitution used for aura/herald above has no "bow" member
			// at all, so it cannot stand in here. pobGem is looked up above, at the totem arm.
			addSkillSpecial(skillNameLower, pobGem.Tags, skillName)
		}
	}

	preSkillNameIndex = newAnchoredIndex(preSkillNameListCompiled)
	skillNameIndex = newAnyOffsetIndex(skillNameListCompiled)
	specialModIndex = newAnchoredIndex(specialModListCompiled)
}

// gemBaseID reads a gem's base-item id off go-pob-data's row. Uncitable: PoB's Data/Gems.lua
// carries the id as a plain field, so nothing dereferences a relation to get at it.
func gemBaseID(gemData *poe.SkillGem) string {
	base := gemData.GetBaseItemType()
	if base == nil {
		return ""
	}
	return base.ID
}

// addSkillSpecial is ModParser.lua:3599-3622 -- the per-gem specialModList families keyed on
// the gem's own skill name, which is how a crafted helmet enchantment ("Barrage fires an
// additional Projectile") reaches a skill.
//
// These entries go straight into specialModListCompiled rather than into specialModList,
// because initializeRegex wraps every specialModList key as "^"+k+"$". PoB does that same
// rewrap at ModParser.lua:3479-3483, which runs BEFORE this loop -- so the keys added here
// keep exactly the anchoring written below: a leading ^ where the Lua has one, and no
// trailing $ anywhere. The trap pattern is deliberately unanchored at both ends.
//
//pob:block:src/Modules/ModParser.lua:4153-4176
func addSkillSpecial(skillNameLower string, tags map[string]bool, skillName string) {
	add := func(pattern string, value interface{}) {
		specialModListCompiled[pattern] = CompiledList[interface{}]{
			Regex: regexp.MustCompile(pattern),
			Value: value,
		}
	}
	extra := func(inner mod.Mod) []mod.Mod {
		return []mod.Mod{MOD("ExtraSkillMod", "LIST", mod.ExtraSkillMod{Mod: inner}).Tag(mod.SkillName(skillName))}
	}
	extraFunc := func(name string, modType mod.Type) func(float64, []string) ([]mod.Mod, string) {
		return func(num float64, captures []string) ([]mod.Mod, string) {
			return extra(MOD(name, modType, num)), ""
		}
	}

	if tags["mine"] {
		add("^"+skillNameLower+` has (\d+)% increased throwing speed`, extraFunc("MineLayingSpeed", "INC"))
	}
	if tags["trap"] {
		add(`(\d+)% increased `+skillNameLower+" throwing speed", extraFunc("TrapThrowingSpeed", "INC"))
	}
	if tags["chaining"] {
		add("^"+skillNameLower+" chains an additional time", extra(MOD("ChainCountMax", "BASE", 1)))
		add("^"+skillNameLower+` chains an additional (\d+) times`, extraFunc("ChainCountMax", "BASE"))
		add("^"+skillNameLower+` chains (\d+) additional times`, extraFunc("ChainCountMax", "BASE"))
	}
	if tags["bow"] {
		// //pob:block:src/Modules/ModParser.lua:6078-6079 — the inner mod carries KeywordFlag.Arrow.
		add("^"+skillNameLower+" fires an additional arrow",
			extra(MOD("ProjectileCount", "BASE", 1).KeywordFlag(mod.KeywordFlagArrow)))
		add("^"+skillNameLower+` fires (\d+) additional arrows?`, func(num float64, captures []string) ([]mod.Mod, string) {
			return extra(MOD("ProjectileCount", "BASE", num).KeywordFlag(mod.KeywordFlagArrow)), ""
		})
	}
	if tags["projectile"] {
		// Pierce is the odd one out: PoB writes it as a DIRECT mod, not an ExtraSkillMod
		// wrapper, so it lands on the player modDB rather than the skill's own list.
		add("^"+skillNameLower+" pierces an additional target",
			[]mod.Mod{MOD("PierceCount", "BASE", 1).Tag(mod.SkillName(skillName))})
		add("^"+skillNameLower+` pierces (\d+) additional targets?`,
			func(num float64, captures []string) ([]mod.Mod, string) {
				return []mod.Mod{MOD("PierceCount", "BASE", num).Tag(mod.SkillName(skillName))}, ""
			})
	}
	if tags["bow"] || tags["projectile"] {
		add("^"+skillNameLower+" fires an additional projectile", extra(MOD("ProjectileCount", "BASE", 1)))
		add("^"+skillNameLower+` fires (\d+) additional projectiles`, extraFunc("ProjectileCount", "BASE"))
		add("^"+skillNameLower+` fires (\d+) additional shard projectiles`, extraFunc("ProjectileCount", "BASE"))
	}
}

// --- Radius jewel funcs (PoB ModParser.lua:3625-3930) ---------------------------------
//
// Four tables, one per pass type, assembled into jewelFuncList. parseMod returns a
// JewelFunc LIST mod carrying the matched entry; calc_setup.go runs the funcs over the
// nodes in the jewel's radius.
//
// All four tables are ported. The one deliberate narrowing is in the bow transform below:
// see bowTransformMasks.

// getSimpleConv is ModParser.lua:3627-3646. It reads the node's ORIGINAL mod list and
// merges its output into the separate working list, so two jewels covering one node each
// transform the untouched original — and MergeMod folds the result into a matching mod
// already there rather than appending, which is why a converted node keeps ONE mod of each
// name and reports the node (not the jewel) as its source.
//
//pob:src/Modules/ModParser.lua:4181-4200
func getSimpleConv(srcList []string, dst string, modType mod.Type, remove bool, factor ...float64) radiusJewelFunc {
	return getSimpleConvSrc(srcList, dst, modType, remove, "", factor...)
}

// getSimpleConvSrc is the same function with PoB's SIXTH parameter, `srcType`, which its own
// comment describes as "for conversions where src and dst types do not match, e.g. increased life
// on base resistances". Three rows of the radius family need it: the pools (Life, Energy Shield,
// Mana) read a BASE resistance and emit an INC pool, so a five-parameter port using one type for
// both sides cannot express them at all.
//
// ⚠️ THE UPSTREAM PREDICATE IS A DISJUNCTION, NOT A SUBSTITUTION.
// `srcType and mod.type == srcType or mod.type == type` parses as
// `(srcType and (mod.type == srcType)) or (mod.type == type)`, so a srcType row still matches a
// mod of the DESTINATION type as well. Reading it as "srcType replaces type" would silently
// narrow every one of those three rows.
//
// The empty string stands in for Lua's nil: mod.Type is a string type, so "" is not a type any
// mod carries.
//
//pob:block:src/Modules/ModParser.lua:18-39
func getSimpleConvSrc(srcList []string, dst string, modType mod.Type, remove bool, srcType mod.Type, factor ...float64) radiusJewelFunc {
	return func(node *radiusJewelNode, out *moddb.ModList, _ *radiusJewelData) {
		if node == nil {
			return
		}
		for _, src := range srcList {
			// ⚠️ A TATTOO'S ATTRIBUTES ARE NOT CONVERTIBLE — ModParser.lua:25's
			// `not (node.isTattoo and attributes[src])`, whose own comment is "do not convert
			// stats from tattoos". It is Str/Dex/Int ONLY, so it does NOT touch the pool or
			// resistance rows: a Life mod derived from a tattoo's fire resistance is legitimate
			// and keeps the tattoo as its source.
			if node.isTattoo && simpleConvAttributes[src] {
				continue
			}
			for _, m := range node.modList.Mods() {
				if m.Name() != src {
					continue
				}
				if !((srcType != "" && m.Type() == srcType) || m.Type() == modType) {
					continue
				}
				value := m.Value()
				if value == nil || value.Type() != mod.ModValueMultiTypeFloat {
					continue
				}
				if remove {
					mergeNewMod(out, src, modType, -value.Float(), m)
				}
				if len(factor) > 0 {
					mergeNewMod(out, dst, modType, math.Floor(value.Float()*factor[0]), m)
				} else {
					mergeNewMod(out, dst, modType, value.Float(), m)
				}
			}
		}
	}
}

// getPerStat is ModParser.lua:3749-3757: tally an attribute over the nodes in radius, then
// emit one scaled mod on the finalise call.
//
//pob:src/Modules/ModParser.lua:6311-6319
func getPerStat(dst string, modType mod.Type, flags mod.MFlag, stat string, factor float64) radiusJewelFunc {
	return func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil {
			// PoB reads `out:Sum(...)`, the WORKING list — already wiped and scaled by the
			// time the second pass runs — not the node's own list.
			d.stats[stat] += out.Sum(mod.TypeBase, nil, stat)
			return
		}

		// PoB's guard is `elseif data[stat] ~= 0`. An absent key is nil in Lua and nil ~= 0
		// is TRUE, so a func whose radius held no node of the right allocation state still
		// emits its zero-valued mod; one that saw nodes summing to exactly 0 emits nothing.
		value, seen := d.stats[stat]
		if seen && value == 0 {
			return
		}

		// math.Floor, not truncation: Lua's math.floor rounds toward -infinity, which is
		// what makes the "reduced … per 10 Strength on Unallocated Passives" jewels land on
		// PoB's numbers for a negative factor.
		m := mod.NewFloat(dst, modType, math.Floor(value*factor)).Source(d.modSource)
		if flags != 0 {
			m.Flag(flags)
		}
		out.AddMod(m)
	}
}

// bowTransformMasks are the three flag masks Lioneye's Fall tests against
// (ModParser.lua:3670-3672): any weapon-type or melee bit, or the full one-handed-melee or
// two-handed-melee pair.
const (
	bowTransformMask1 = mod.MFlagAxe | mod.MFlagClaw | mod.MFlagDagger | mod.MFlagMace |
		mod.MFlagStaff | mod.MFlagSword | mod.MFlagMelee
	bowTransformMask2 = mod.MFlagWeapon1H | mod.MFlagWeaponMelee
	bowTransformMask3 = mod.MFlagWeapon2H | mod.MFlagWeaponMelee
)

// bowTransformUsingConditions is PoB's `using` table (ModParser.lua:3678) — the melee-weapon
// Condition vars the second branch rewrites to UsingBow.
var bowTransformUsingConditions = map[string]bool{
	"UsingAxe":         true,
	"UsingClaw":        true,
	"UsingDagger":      true,
	"UsingMace":        true,
	"UsingStaff":       true,
	"UsingSword":       true,
	"UsingMeleeWeapon": true,
}

// bowTransform is Lioneye's Fall, ModParser.lua:3668-3696. Per matching mod on the node it
// emits the mod NEGATED with its original parameters — which MergeMod folds into the node's
// own mod, leaving it at 0 — plus a copy carrying either a recomputed flag mask or a rewritten
// Condition tag. Both halves survive into PoB's dump, so the zeroed original is observable
// rather than an implementation detail.
//
// NARROWED: a mod whose value is not a number is skipped. PoB negates unconditionally and
// would error on a FLAG or LIST value; measured over all 2027 corpus builds, no node mod
// carrying one of the masks above has a non-numeric value, so the narrowing is unreachable
// rather than a behaviour change.
//
//pob:block:src/Modules/ModParser.lua:6144-6172
func bowTransform(node *radiusJewelNode, out *moddb.ModList, _ *radiusJewelData) {
	if node == nil {
		return
	}

	for _, m := range node.modList.Mods() {
		value := m.Value()
		if value == nil || value.Type() != mod.ModValueMultiTypeFloat {
			continue
		}

		flags := m.Flags()
		if flags&bowTransformMask1 != 0 ||
			flags&bowTransformMask2 == bowTransformMask2 ||
			flags&bowTransformMask3 == bowTransformMask3 {
			bowTransformMerge(out, m, -value.Float(), flags, m.Tags())
			bowTransformMerge(out, m, value.Float(),
				flags&^(bowTransformMask1|bowTransformMask2|bowTransformMask3)|mod.MFlagBow, m.Tags())
			continue
		}

		if rewritten, ok := rewriteUsingConditionToBow(m.Tags()); ok {
			bowTransformMerge(out, m, -value.Float(), flags, m.Tags())
			bowTransformMerge(out, m, value.Float(), flags, rewritten)
		}
	}
}

// bowTransformMerge is the MergeNewMod call the transform makes four times: everything but
// the value, the flag mask and the tag list comes off the prototype. calc_setup.go's
// mergeNewMod copies the prototype's flags and tags instead, which is exactly what this one
// must not do.
//
//pob:block:src/Modules/ModParser.lua:6151-6152
func bowTransformMerge(out *moddb.ModList, proto mod.Mod, value float64, flags mod.MFlag, tags []mod.Tag) {
	m := mod.NewFloat(proto.Name(), proto.Type(), value).
		Source(proto.GetSource()).
		Flag(flags).
		KeywordFlag(proto.KeywordFlags())
	if len(tags) > 0 {
		m.Tag(tags...)
	}
	mergeMod(out, m)
}

// rewriteUsingConditionToBow is the `newTagList` half of the transform: the FIRST Condition
// tag naming a melee weapon becomes UsingBow. PoB deep-copies the mod's tag table and mutates
// the copy; go-pob's tags are shared pointers, so the replacement is built fresh and every
// other tag is carried over untouched.
//
//pob:block:src/Modules/ModParser.lua:6153-6168
func rewriteUsingConditionToBow(tags []mod.Tag) ([]mod.Tag, bool) {
	for i, tag := range tags {
		cond, ok := tag.(*mod.ConditionTag)
		if !ok || len(cond.VarList) != 1 || !bowTransformUsingConditions[cond.VarList[0]] {
			continue
		}

		out := make([]mod.Tag, len(tags))
		copy(out, tags)
		out[i] = mod.Condition("UsingBow").Neg(cond.Negative)

		return out, true
	}

	return nil, false
}

// jewelOtherFuncs is ModParser.lua:3647-3748 — the funcs that rewrite OTHER nodes in the
// radius. Keys are the mod line verbatim; jewelFuncList lowercases them.
var jewelOtherFuncs = map[string]radiusJewelFunc{
	"Strength from Passives in Radius is Transformed to Dexterity":     getSimpleConv([]string{"Str"}, "Dex", mod.TypeBase, true),
	"Dexterity from Passives in Radius is Transformed to Strength":     getSimpleConv([]string{"Dex"}, "Str", mod.TypeBase, true),
	"Strength from Passives in Radius is Transformed to Intelligence":  getSimpleConv([]string{"Str"}, "Int", mod.TypeBase, true),
	"Intelligence from Passives in Radius is Transformed to Strength":  getSimpleConv([]string{"Int"}, "Str", mod.TypeBase, true),
	"Dexterity from Passives in Radius is Transformed to Intelligence": getSimpleConv([]string{"Dex"}, "Int", mod.TypeBase, true),
	"Intelligence from Passives in Radius is Transformed to Dexterity": getSimpleConv([]string{"Int"}, "Dex", mod.TypeBase, true),

	"Increases and Reductions to Life in Radius are Transformed to apply to Energy Shield":          getSimpleConv([]string{"Life"}, "EnergyShield", mod.TypeIncrease, true),
	"Increases and Reductions to Physical Damage in Radius are Transformed to apply to Cold Damage": getSimpleConv([]string{"PhysicalDamage"}, "ColdDamage", mod.TypeIncrease, true),
	"Increases and Reductions to Cold Damage in Radius are Transformed to apply to Physical Damage": getSimpleConv([]string{"ColdDamage"}, "PhysicalDamage", mod.TypeIncrease, true),
	// :6101. MEASURED ZERO -- 0 of 8648 corpus builds -- and ported because a table missing a row
	// is invisible to every instrument that reads the table.
	"Increases and Reductions to Evasion Rating in Radius are Transformed to apply to Armour": getSimpleConv([]string{"Evasion"}, "Armour", mod.TypeIncrease, true),
	"Increases and Reductions to other Damage Types in Radius are Transformed to apply to Fire Damage": getSimpleConv(
		// ⚠️ FIVE SOURCE TYPES UPSTREAM, NOT FOUR (ModParser.lua:6110). `ElementalDamage` was
		// dropped, so a passive's "increased Elemental Damage" was left untransformed.
		[]string{"PhysicalDamage", "ColdDamage", "LightningDamage", "ChaosDamage", "ElementalDamage"}, "FireDamage", mod.TypeIncrease, true),

	"Melee and Melee Weapon Type modifiers in Radius are Transformed to Bow Modifiers": bowTransform,

	"Notable Passive Skills in Radius grant nothing": func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil && node.nodeType == "Notable" {
			out.AddMod(mod.NewFlag("PassiveSkillHasNoEffect", true).Source(d.modSource))
		}
	},
	"Allocated Small Passive Skills in Radius grant nothing": func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil && node.nodeType == "Normal" {
			out.AddMod(mod.NewFlag("AllocatedPassiveSkillHasNoEffect", true).Source(d.modSource))
		}
	},
	// :6197, the NOTABLE twin of the row above, which was ported alone. Same mod name, one word
	// of difference, 28 corpus builds. Porting one of an adjacent pair is how the other stays
	// missing, and a grep for the mod name reads as covered.
	//pob:src/Modules/ModParser.lua:6197
	"Allocated Notable Passive Skills in Radius grant nothing": func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil && node.nodeType == "Notable" {
			out.AddMod(mod.NewFlag("AllocatedPassiveSkillHasNoEffect", true).Source(d.modSource))
		}
	},
}

// jewelSelfFuncs is ModParser.lua:3758-3787 — the funcs that give the JEWEL a bonus derived
// from the ALLOCATED nodes in its radius.
var jewelSelfFuncs = map[string]radiusJewelFunc{
	"Adds 1 to maximum Life per 3 Intelligence in Radius":                                  getPerStat("Life", mod.TypeBase, 0, "Int", 1.0/3),
	"Adds 1 to Maximum Life per 3 Intelligence Allocated in Radius":                        getPerStat("Life", mod.TypeBase, 0, "Int", 1.0/3),
	"1% increased Evasion Rating per 3 Dexterity Allocated in Radius":                      getPerStat("Evasion", mod.TypeIncrease, 0, "Dex", 1.0/3),
	"1% increased Claw Physical Damage per 3 Dexterity Allocated in Radius":                getPerStat("PhysicalDamage", mod.TypeIncrease, mod.MFlagClaw, "Dex", 1.0/3),
	"1% increased Melee Physical Damage while Unarmed per 3 Dexterity Allocated in Radius": getPerStat("PhysicalDamage", mod.TypeIncrease, mod.MFlagUnarmed, "Dex", 1.0/3),
	"3% increased Totem Life per 10 Strength in Radius":                                    getPerStat("TotemLife", mod.TypeIncrease, 0, "Str", 3.0/10),
	"3% increased Totem Life per 10 Strength Allocated in Radius":                          getPerStat("TotemLife", mod.TypeIncrease, 0, "Str", 3.0/10),
	"Adds 1 maximum Lightning Damage to Attacks per 1 Dexterity Allocated in Radius":       getPerStat("LightningMax", mod.TypeBase, mod.MFlagAttack, "Dex", 1),
	"5% increased Chaos damage per 10 Intelligence from Allocated Passives in Radius":      getPerStat("ChaosDamage", mod.TypeIncrease, 0, "Int", 5.0/10),

	"Dexterity and Intelligence from passives in Radius count towards Strength Melee Damage bonus": func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil {
			// This one reads node.modList, not the working list.
			d.stats["Dex"] += node.modList.Sum(mod.TypeBase, nil, "Dex")
			d.stats["Int"] += node.modList.Sum(mod.TypeBase, nil, "Int")
			return
		}
		_, hasDex := d.stats["Dex"]
		_, hasInt := d.stats["Int"]
		if !hasDex && !hasInt {
			return
		}
		out.NewMod("DexIntToMeleeBonus", mod.TypeBase, d.stats["Dex"]+d.stats["Int"], d.modSource)
	},

	"-1 Strength per 1 Strength on Allocated Passives in Radius":                                             getPerStat("Str", mod.TypeBase, 0, "Str", -1),
	"1% additional Physical Damage Reduction per 10 Strength on Allocated Passives in Radius":                getPerStat("PhysicalDamageReduction", mod.TypeBase, 0, "Str", 1.0/10),
	"2% increased Life Recovery Rate per 10 Strength on Allocated Passives in Radius":                        getPerStat("LifeRecoveryRate", mod.TypeIncrease, 0, "Str", 2.0/10),
	"3% increased Life Recovery Rate per 10 Strength on Allocated Passives in Radius":                        getPerStat("LifeRecoveryRate", mod.TypeIncrease, 0, "Str", 3.0/10),
	"-1 Intelligence per 1 Intelligence on Allocated Passives in Radius":                                     getPerStat("Int", mod.TypeBase, 0, "Int", -1),
	"0.4% of Energy Shield Regenerated per Second for every 10 Intelligence on Allocated Passives in Radius": getPerStat("EnergyShieldRegenPercent", mod.TypeBase, 0, "Int", 0.4/10),
	"2% increased Mana Recovery Rate per 10 Intelligence on Allocated Passives in Radius":                    getPerStat("ManaRecoveryRate", mod.TypeIncrease, 0, "Int", 2.0/10),
	"3% increased Mana Recovery Rate per 10 Intelligence on Allocated Passives in Radius":                    getPerStat("ManaRecoveryRate", mod.TypeIncrease, 0, "Int", 3.0/10),
	"-1 Dexterity per 1 Dexterity on Allocated Passives in Radius":                                           getPerStat("Dex", mod.TypeBase, 0, "Dex", -1),
	"2% increased Movement Speed per 10 Dexterity on Allocated Passives in Radius":                           getPerStat("MovementSpeed", mod.TypeIncrease, 0, "Dex", 2.0/10),
	"3% increased Movement Speed per 10 Dexterity on Allocated Passives in Radius":                           getPerStat("MovementSpeed", mod.TypeIncrease, 0, "Dex", 3.0/10),
}

// jewelSelfUnallocFuncs is ModParser.lua:3788-3800 — same, but derived from the
// UNALLOCATED nodes in radius, which is why those nodes need building at all
// (env.extraRadiusNodeList).
var jewelSelfUnallocFuncs = map[string]radiusJewelFunc{
	"+5% to Critical Strike Multiplier per 10 Strength on Unallocated Passives in Radius":      getPerStat("CritMultiplier", mod.TypeBase, 0, "Str", 5.0/10),
	"+7% to Critical Strike Multiplier per 10 Strength on Unallocated Passives in Radius":      getPerStat("CritMultiplier", mod.TypeBase, 0, "Str", 7.0/10),
	"2% reduced Life Recovery Rate per 10 Strength on Unallocated Passives in Radius":          getPerStat("LifeRecoveryRate", mod.TypeIncrease, 0, "Str", -2.0/10),
	"+15 to maximum Mana per 10 Dexterity on Unallocated Passives in Radius":                   getPerStat("Mana", mod.TypeBase, 0, "Dex", 15.0/10),
	"+100 to Accuracy Rating per 10 Intelligence on Unallocated Passives in Radius":            getPerStat("Accuracy", mod.TypeBase, 0, "Int", 100.0/10),
	"+125 to Accuracy Rating per 10 Intelligence on Unallocated Passives in Radius":            getPerStat("Accuracy", mod.TypeBase, 0, "Int", 125.0/10),
	"2% reduced Mana Recovery Rate per 10 Intelligence on Unallocated Passives in Radius":      getPerStat("ManaRecoveryRate", mod.TypeIncrease, 0, "Int", -2.0/10),
	"+3% to Damage over Time Multiplier per 10 Intelligence on Unallocated Passives in Radius": getPerStat("DotMultiplier", mod.TypeBase, 0, "Int", 3.0/10),
	"2% reduced Movement Speed per 10 Dexterity on Unallocated Passives in Radius":             getPerStat("MovementSpeed", mod.TypeIncrease, 0, "Dex", -2.0/10),
	"+125 to Accuracy Rating per 10 Dexterity on Unallocated Passives in Radius":               getPerStat("Accuracy", mod.TypeBase, 0, "Dex", 125.0/10),

	// :6362-6377 and :6378-6392. ⚠️ THE NOTABLE TWIN WAS ABSENT (49 corpus builds) AND THE SMALL
	// ONE DROPPED THE `Condition:ConnectedTo` FILTER. Upstream skips those mods explicitly --
	// "these nodes are not technically allocated by this jewel func" -- and copying the whole
	// working list grants a connectivity condition for a node the character never allocated,
	// which is an over-application no missing-thing census can see.
	//pob:block:src/Modules/ModParser.lua:6362-6392
	"Grants all bonuses of Unallocated Small Passive Skills in Radius":   grantUnallocatedBonuses("Normal"),
	"Grants all bonuses of Unallocated Notable Passive Skills in Radius": grantUnallocatedBonuses("Notable"),
}

// grantUnallocatedBonuses is ModParser.lua:6362-6392, whose two rows differ only in the node type
// they collect. One definition rather than two, because two copies is how one stays wrong -- which
// is exactly what happened: the Small row shipped without the filter and the Notable row not at all.
//
//pob:block:src/Modules/ModParser.lua:6362-6392
func grantUnallocatedBonuses(nodeType string) radiusJewelFunc {
	return func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
		if node != nil {
			if node.nodeType == nodeType {
				if d.modList == nil {
					d.modList = moddb.NewModList()
				}
				// The working list, which by now carries the node's own mods plus whatever the
				// first pass added to it -- including the AllocatedPassiveSkillHasNoEffect flag
				// an Unnatural Instinct's own Other func stamped on, since an UNALLOCATED node
				// never hits the wipe.
				//
				// ⚠️ MINUS the Condition:ConnectedTo* mods (:6367-6371). An unallocated node is
				// not on the character's path, so carrying its connectivity conditions across
				// grants a "connected to X start" the build has not earned.
				for _, m := range out.Mods() {
					if strings.HasPrefix(m.Name(), "Condition:ConnectedTo") {
						continue
					}
					d.modList.AddMod(m)
				}
			}
			return
		}
		if d.modList != nil {
			out.AddList(d.modList)
		}
	}
}

// radiusGrantAppliesTo is the node-type guard the `Passive Skills in Radius also grant …` rows
// share (ModParser.lua:6219 and siblings). Keystones, jewel Sockets and ClassStart nodes are
// excluded; every other node in the radius receives the grant.
func radiusGrantAppliesTo(node *radiusJewelNode) bool {
	return node != nil &&
		node.nodeType != "Keystone" &&
		node.nodeType != "Socket" &&
		node.nodeType != "ClassStart"
}

// firstToUpper is PoB's `type:gsub("^%l", string.upper)` (ModParser.lua:6279). The line is
// lowercased before matching, so the captured damage type arrives as "physical" and the mod name
// it must build is "PhysicalDamage".
func firstToUpper(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// enemyDamageConvertRow is ModParser.lua:3484-3487, which is one row four times over: only the
// ailment condition varies, and the "nearby enemies" arm has none. An empty condition means an
// untagged nested mod, not a tag with an empty var.
//
// ⚠️ IT RETURNS THE UNNAMED FUNC TYPE, NOT SpecialFuncType. The dispatch at mod_parser.go:8439
// type-asserts against the literal signature, and Go matches a dynamic type EXACTLY -- a value
// stored as the named alias would fall through that assertion into the []mod.Mod branch below it
// and panic on every line it matched.
func enemyDamageConvertRow(condition string) func(num float64, captures []string) ([]mod.Mod, string) {
	return func(num float64, captures []string) ([]mod.Mod, string) {
		// captures[1] and [2] arrive lowercased, as PoB's `damageFrom:gsub("^%l", string.upper)`
		// assumes; firstToUpper is that gsub.
		nested := MOD(firstToUpper(captures[1])+"DamageConvertTo"+firstToUpper(captures[2]), "BASE", num)
		if condition != "" {
			nested = nested.Tag(mod.Condition(condition))
		}
		return []mod.Mod{MOD("EnemyModifier", "LIST", mod.EnemyModifier{Mod: nested})}, ""
	}
}

// radiusGrantSimple builds the common one-mod form of those rows.
func radiusGrantSimple(name string, modType mod.Type) func(captures []string) radiusJewelFunc {
	return func(captures []string) radiusJewelFunc {
		num := utils.Float(captures[0])
		return func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
			if !radiusGrantAppliesTo(node) {
				return
			}
			out.AddMod(mod.NewFloat(name, modType, num).Source(d.modSource))
		}
	}
}

// simpleConvAttributes is getSimpleConv's local `attributes` table (ModParser.lua:20).
var simpleConvAttributes = map[string]bool{"Str": true, "Dex": true, "Int": true}

// simpleConvPercent turns the `(%d+)%%` capture every getSimpleConv row carries into PoB's
// `num / 100` factor.
func simpleConvPercent(srcList []string, dst string, modType mod.Type, remove bool, srcType mod.Type) func([]string) radiusJewelFunc {
	return func(captures []string) radiusJewelFunc {
		return getSimpleConvSrc(srcList, dst, modType, remove, srcType, utils.Float(captures[0])/100)
	}
}

// jewelFuncPattern is a parameterised jewelFuncList entry: PoB finds these by scanning the
// table with lineLower:find(pattern) and feeding the captures to the outer function.
type jewelFuncPattern struct {
	re    *regexp.Regexp
	typ   string
	build func(captures []string) radiusJewelFunc
}

// jewelFuncPatternsRaw are the parameterised entries, in the pass-type table they came
// from. PoB scans them with pairs(); the slice below is sorted at init so a line matching
// two patterns cannot resolve on Go's randomised map order.
var jewelFuncPatternsRaw = []struct {
	pattern string
	typ     string
	build   func(captures []string) radiusJewelFunc
}{
	// ModParser.lua:6217-6282 — the nine remaining `Passive Skills in Radius also grant …` rows.
	// The machinery below was already here and exercised by the two rows that follow; only these
	// table entries were missing, so every jewel carrying one had its line DROPPED WHOLE.
	//
	// ⚠️ THE GUARD IS WIDER THAN THE TWO ROWS BELOW. PoB excludes Keystone, Socket AND ClassStart
	// on these (`node.type ~= "Keystone" and ~= "Socket" and ~= "ClassStart"`), where the
	// trap/mine row excludes only Keystone. Reusing the narrower guard would grant the bonus on
	// jewel sockets and class-start nodes — a silent OVER-application, which no value gate can
	// tell apart from a missing producer.
	{
		pattern: `passive skills in radius also grant (\d+)% increased global critical strike chance`,
		typ:     "Other",
		build:   radiusGrantSimple("CritChance", mod.TypeIncrease),
	},
	{
		pattern: `passive skills in radius also grant \+(\d+) to maximum life`,
		typ:     "Other",
		build:   radiusGrantSimple("Life", mod.TypeBase),
	},
	{
		pattern: `passive skills in radius also grant \+(\d+) to maximum mana`,
		typ:     "Other",
		build:   radiusGrantSimple("Mana", mod.TypeBase),
	},
	{
		pattern: `passive skills in radius also grant (\d+)% increased energy shield`,
		typ:     "Other",
		build:   radiusGrantSimple("EnergyShield", mod.TypeIncrease),
	},
	{
		pattern: `passive skills in radius also grant (\d+)% increased armour`,
		typ:     "Other",
		build:   radiusGrantSimple("Armour", mod.TypeIncrease),
	},
	{
		pattern: `passive skills in radius also grant (\d+)% increased evasion rating`,
		typ:     "Other",
		build:   radiusGrantSimple("Evasion", mod.TypeIncrease),
	},
	{
		// :6259-6267 writes Str, Dex, Int AND "All" — the fourth is not redundant, it is the key
		// the "all attributes" consumers read.
		pattern: `passive skills in radius also grant \+(\d+) to all attributes`,
		typ:     "Other",
		build: func(captures []string) radiusJewelFunc {
			num := utils.Float(captures[0])
			return func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
