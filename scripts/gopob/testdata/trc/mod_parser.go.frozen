// gemLookups ports the two name-keyed tables the mod parser needs to turn a gem NAME out of
// item text into a skill id: PoB's gemIdLookup (ModParser.lua:1474-1481) and the slice of
// data.gemForBaseName (Data.lua:718) that ModParser.lua:2223 reads.
type gemLookups struct {
	// skillIDForName is gemIdLookup: lowercase gem name -> granted effect id.
	skillIDForName map[string]string
	// gemForBaseName is data.gemForBaseName: lowercase gem base item name (WITH the
	// " Support" suffix, as PoB stores it) -> the gem itself.
	gemForBaseName map[string]*poe.SkillGem
}

var gemLookup = sync.OnceValue(buildGemLookup)

// gemKeywordWordPattern is Lua's `%w+` character class: letters and digits, no underscore.
var gemKeywordWordPattern = regexp.MustCompile(`[a-zA-Z0-9]+`)

// buildGemLookup ports ModParser.lua:1474-1481.
//
// PoB walks `data.skills` — its own hand-written table of 912 granted effects, transcribed as
// raw.PoBSkills — and keys each by `grantedEffect.name:lower()`. Both halves of that sentence
// are load-bearing and go-pob-data satisfies neither:
//
//   - the SET. poe.GrantedEffects holds 10020 rows, so "vulnerability" alone has 16 candidates,
//     15 of them monster skills, and the surplus leaks ordinary English words (ignite, backstab,
//     riptide, taunt, kill, mortar) into a table matched against item text. Narrowing to the
//     effects a real gem base item grants removed the worst of it but not the class: it still
//     admitted 558 names against PoB's 647, over-applying 119 and missing PoB's item-granted
//     pseudo-skills entirely.
//   - the NAME. PoB's `grantedEffect.name` is not the game's ActiveSkills.DisplayedName. They
//     diverge on exactly the population :1478's `fromItem` arm exists for — PoB calls
//     SummonVoidSphere "Summon Volatile Anomaly" where go-pob-data calls it "Volatile Anomaly",
//     so "Trigger Level 20 Summon Volatile Anomaly on Kill" resolved to nothing at all.
//
// gemForBaseName still comes from go-pob-data, because it is keyed on the GEM BASE ITEM name
// (:2223 reads `data.gemForBaseName`, a different table) which PoB's skill table does not carry.
// Royale bases are dropped there: PoB does not ship them and each duplicates the name of the gem
// it mirrors.
//
// PoB builds the table with `pairs`, so its winner is undefined on the 16 names two of its own
// skills share. Here the non-support wins, which is the case both consumers are written for —
// :2223 re-derives the SUPPORT from the active skill's name, so the active skill must be what
// the name resolves to. PoB documents that collision for "barrage" at CalcSetup.lua:924.
//
//pob:block:src/Modules/ModParser.lua:1605-1612
func buildGemLookup() *gemLookups {
	lookups := &gemLookups{
		// PoB seeds exactly this one entry by hand (ModParser.lua:1474-1476). It is needed
		// because the gem base item is named "Power Charge On Critical" while the granted
		// effect id spells "Critical" in full. The id seeded here used to be truncated, which
		// is not a key of raw.PoBSkills at all, so the seed resolved to nothing.
		skillIDForName: map[string]string{"power charge on critical strike": "SupportPowerChargeOnCritical"},
		gemForBaseName: make(map[string]*poe.SkillGem),
	}

	for _, effect := range poe.GrantedEffects {
		// ⚠️ NOT effect.GetSkillGem(). go-pob-data leaves SkillGem.GrantedEffect at 0 on all 847
		// gems, so poe's index (`skillGemsByGrantedEffect[obj.GrantedEffect] = obj`) collapses to
		// ONE entry and that accessor resolved for 1 granted effect in 12816 -- which left
		// gemForBaseName holding a single gem instead of 608, and every extraSupportIDsForName
		// lookup below falling through to the SKILL id where PoB resolves the SUPPORT.
		gem := raw2.SkillGemForGrantedEffectID(effect.ID)
		if gem == nil {
			continue
		}

		base := gem.GetBaseItemType()
		if base == nil || strings.Contains(base.ID, "Royale") {
			continue
		}

		lookups.gemForBaseName[strings.ToLower(base.Name)] = gem
	}

	// Sorted, not map order: two skills sharing a name would otherwise freeze a winner per
	// process, which is precisely the defect class the cross-process determinism gate exists for.
	ids := make([]string, 0, len(raw2.PoBSkills))
	for id := range raw2.PoBSkills {
		ids = append(ids, id)
	}
	sort.Strings(ids)

	for _, id := range ids {
		skill := raw2.PoBSkills[id]
		if skill.Hidden && !skill.FromItem && !skill.FromTree {
			continue
		}
		name := strings.ToLower(skill.Name)
		if existing, taken := lookups.skillIDForName[name]; taken {
			if previous, known := raw2.PoBSkills[existing]; !known || !previous.Support || skill.Support {
				continue
			}
		}
		lookups.skillIDForName[name] = id
	}

	return lookups
}

// extraSkillIDForName is the gemIdLookup read at ModParser.lua:1484 and :1495.
//
// It used to fall back to a second map keyed on go-pob-data's ACTIVE SKILL display name, on the
// premise that skillIDForName could not reach an item- or tree-granted skill because such a skill
// has no gem base item. That premise held only while the lookup was built from go-pob-data;
// raw.PoBSkills is PoB's whole table, `fromItem` rows included, so the fallback is now a pure
// superset leak — it resolved `taunt`, `kill`, `default attack` and 111 more names PoB has no
// entry for, plus three reachable from real corpus item text (`call of steel`,
// `glimpse of eternity`, `summon arbalists`) where PoB grants nothing and we granted a skill.
//
//pob:block:src/Modules/ModParser.lua:1615-1617
func extraSkillIDForName(name string) string {
	return gemLookup().skillIDForName[strings.ToLower(name)]
}

// extraSupportIDsForName ports ModParser.lua:2220-2234: resolve a support gem named in item
// text to the granted effect ids an ExtraSupport mod should carry.
//
// The gemForBaseName round trip is what makes "supported by level 20 Barrage" find the
// SUPPORT gem rather than the skill gem of the same name.
// PoB matches its patterns against line:lower() and so captures lowercase text
// (ModParser.lua:3974-3976); go-pob's scan deliberately returns the original case, so the
// name is folded here rather than at the shared scan.
//
// :2223 keys gemForBaseName on `data.skills[skillId].name .. " Support"` — PoB's OWN skill name,
// not the base item's — so the round trip goes through raw.PoBSkills. It used to re-derive the
// name from go-pob-data's base item, which is a second place the two naming schemes could differ.
//
// extraSupportSlotName is the slot normalisation of PoB's extraSupport, ModParser.lua:2075-2083.
//
// PoB title-cases with `string.gsub(" "..slot, "%W%l", string.upper):sub(2)` -- upper-case any
// lower-case letter that follows a non-word character -- after special-casing the two weapon
// names. "helmet" becomes "Helmet" and "body armour" becomes "Body Armour", which are the keys the
// SocketedIn tag is matched against.
//
//pob:block:src/Modules/ModParser.lua:2454-2468
//pob:block:src/Modules/ModParser.lua:2075-2083
func extraSupportSlotName(slot string) string {
	switch strings.ToLower(strings.TrimSpace(slot)) {
	case "main hand", "main hand weapon":
		return "Weapon 1"
	case "off hand", "off hand weapon":
		return "Weapon 2"
	case "":
		return "{SlotName}"
	}
	words := strings.Fields(strings.ToLower(slot))
	for i, w := range words {
		words[i] = strings.ToUpper(w[:1]) + w[1:]
	}
	return strings.Join(words, " ")
}

// extraSupportEntry is one entry of the list PoB's extraSupport returns. The two shapes are not
// interchangeable: a support is granted with a SocketedIn tag and a skill is granted with no tag
// at all, so collapsing them to a bare id loses the distinction the caller needs.
type extraSupportEntry struct {
	skillID string
	// asSkill is ModParser.lua:2093-2094. A gem's SECONDARY granted effect is granted as an
	// ExtraSkill rather than an ExtraSupport when the effect is not itself a support -- the
	// triggered half of Impending Doom, Prismatic Burst, Kinetic Instability and 16 more.
	asSkill bool
}

func extraSupportIDsForName(name string) []extraSupportEntry {
	lookups := gemLookup()

	name = strings.ToLower(name)

	// ModParser.lua:2073 is a THREE-way disjunction and go-pob carried two arms. The third
	// strips a trailing " support", which is what the item text actually says whenever it names
	// the support gem in full rather than the skill it shares a name with.
	skillID, ok := lookups.skillIDForName[name]
	if !ok {
		skillID, ok = lookups.skillIDForName[strings.TrimPrefix(name, "increased ")]
	}
	if !ok {
		skillID, ok = lookups.skillIDForName[strings.TrimSuffix(name, " support")]
	}
	if !ok {
		return nil
	}

	supportGem, ok := lookups.gemForBaseName[strings.ToLower(raw2.PoBSkills[skillID].Name)+" support"]
	if !ok {
		return []extraSupportEntry{{skillID: skillID}}
	}

	// ⚠️ NOT GetGrantedEffect()/GetSecondaryGrantedEffect(). Both read the same zeroed FK: the
	// first returned GrantedEffects[0] -- one arbitrary effect -- for EVERY gem in the game, and
	// the second nil for every gem, because SecondaryGrantedEffect is nil on all 847.
	//
	// GrantedEffectsForGem returns primary before secondary, which is what makes the index test
	// below legitimate: :2089 grants the PRIMARY as a support unconditionally and only :2090-2095
	// asks what the secondary is.
	effects := raw2.GrantedEffectsForGem(supportGem)
	entries := make([]extraSupportEntry, 0, len(effects))
	for i, effect := range effects {
		entries = append(entries, extraSupportEntry{
			skillID: effect.ID,
			asSkill: i > 0 && !raw2.PoBSkills[effect.ID].Support,
		})
	}
	if len(entries) == 0 {
		return []extraSupportEntry{{skillID: skillID}}
	}
	return entries
}

// extraSupportMods is the mod-building half of PoB's extraSupport (ModParser.lua:2086-2103),
// shared by the two rows that call it so the skill/support split cannot be ported to one and
// not the other.
func extraSupportMods(entries []extraSupportEntry, level int, slotName string) []mod.Mod {
	mods := make([]mod.Mod, 0, len(entries))
	for _, entry := range entries {
		if entry.asSkill {
			mods = append(mods, MOD("ExtraSkill", "LIST", mod.ExtraSkill{SkillID: entry.skillID, Level: level}))
			continue
		}
		mods = append(mods, MOD("ExtraSupport", "LIST", mod.ExtraSupport{SkillID: entry.skillID, Level: level}).Tag(mod.SocketedIn(slotName)))
	}
	return mods
}

// grantedExtraSkill turns a named skill granted by item text into an ExtraSkill LIST mod.
//
// PoB gates on gemIdLookup and returns nil for an unknown name; go-pob carries the name
// through so the mod still exists for the census instruments to see, and leaves SkillID empty.
// Item.grantedSkills skips an entry with no SkillID, which is the same population PoB's nil
// return produces there.
//
// PoB does NOT set `triggered` here — only triggerExtraSkill does (:1497). The unconditional
// `Triggered: true` this used to carry was a porting error with no consumer; Item.GrantedSkills
// is the first consumer, so it is corrected in the same change.
//
// The fold to lowercase is the same one extraSupportIDsForName documents: PoB matches against
// `line:lower()` (ModParser.lua:3974-3976) so its capture is already lowercase and
// `name:gsub(" skill","")` bites. go-pob's scan returns the ORIGINAL case, so the suffix cut
// silently missed every "… Skill" line — which is all 300-odd of them in the corpus.
//
//pob:src/Modules/ModParser.lua:1613-1620
func grantedExtraSkill(name string, level int, noSupports bool) []mod.Mod {
	name, _ = strings.CutSuffix(strings.ToLower(name), " skill")
	return []mod.Mod{
		MOD("ExtraSkill", "LIST", mod.ExtraSkill{SkillID: extraSkillIDForName(name), SkillName: name, Level: level, NoSupports: noSupports}),
	}
}

// triggerExtraSkill is grantedExtraSkill with a source skill recorded on the mod.
//
//pob:src/Modules/ModParser.lua:1621-1631
func triggerExtraSkill(name string, level int, noSupports bool, sourceSkill string) []mod.Mod {
	name, _ = strings.CutSuffix(strings.ToLower(name), " skill")
	sourceSkill, _ = strings.CutSuffix(strings.ToLower(sourceSkill), " skill")
	skill := mod.ExtraSkill{SkillID: extraSkillIDForName(name), SkillName: name, Level: level, NoSupports: noSupports, Triggered: true}
	if sourceSkill != "" {
		skill.Source = sourceSkill
	}
	return []mod.Mod{
		MOD("ExtraSkill", "LIST", skill),
	}
}

