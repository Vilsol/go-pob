	// ModParser.lua:2400, and the pin's own comment is the reason: "Override as increased maximum
	// is always global". The generic row maps both `energy shield` and `maximum energy shield` to
	// the same `EnergyShield` name, so without this override the two wordings are indistinguishable
	// and calcLocal drains BOTH into the item's own armour recompute.
	//
	// ⚠️ THE TAG IS THE WHOLE MECHANISM. calcLocal skips a mod whose first tag is anything but
	// InSlot (Item.lua:2160), so the Global tag is what keeps this out of the local derivation.
	// Missing it moves the percentage OUT of the global defence multiplier and INTO one item's
	// base — which RAISES that item and LOWERS the total, because the multiplier reaches every
	// slot plus the global base while the local application reaches one item.
	//
	// There is no sibling override for Armour, Evasion or Ward: "maximum" is not a wording those
	// stats take, and the pin has no such row for them either.
	`(\d+)% increased maximum energy shield`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{MOD("EnergyShield", "INC", num).Tag(mod.Global())}, ""
	},
	`(\d+)% increased global maximum energy shield and reduced lightning resistance`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("EnergyShield", "INC", num).Tag(mod.Global()),
			MOD("LightningResist", "INC", -num),
		}, ""
	},
