	"lightning resistance":  {names: []string{"LightningPenetration"}},
	"cold resistance":       {names: []string{"ColdPenetration"}},
	"fire resistance":       {names: []string{"FirePenetration"}},
	"elemental resistance":  {names: []string{"ElementalPenetration"}},
	"elemental resistances": {names: []string{"ElementalPenetration"}},
	"chaos resistance":      {names: []string{"ChaosPenetration"}},
}

var regenTypesCompiled map[string]CompiledList[modNameListType]

// regenTypes is ModParser.lua:5991 -- the fourth `appendMod(resourceTypes, ...)` member, and
// it is DERIVED like its three siblings rather than written out.
//
// It used to be nine hand-written rows against the pin's 32. Every one of the nine is
// reproduced exactly by the derivation, name for name, so this is purely additive: 23 keys
// that previously indexed to the zero value -- an empty name list, which drops the whole mod
// -- now resolve. TestRegenTypesCoversFormerHandWrittenRows is that superset check.
//
// ⚠️ THE DECLARED GAP BELOW SAID "WHICH SIDE IS RIGHT IS NOT ESTABLISHED HERE" AND NAMED NO
// SEARCH. The search is one map comparison and it settles the question outright, which is
// what is meant by a declared gap having to name the search it ran: the note read as
// a considered decision and cost nothing to re-open.
var regenTypes = resourceTypesWithSuffix("Regen")

// degenTypes, costTypes and baseCostTypes are ModParser.lua:5992-5994 --
// `appendMod(resourceTypes, "Degen" / "Cost" / "CostNoMult")` over resourceTypes.
// Written out here because this tree has no appendMod.
//
// All four members now share one derivation, so the key sets cannot drift apart again. That
// was the actual defect: regenTypes was the only one written by hand, and being written by
// hand is what let it hold four keys the table had no counterpart for while missing nine.
//
// PoB serves a pre-baked Data/ModCache.lua into the very memo table modLib.parseMod reads
// (Main.lua:133), so a line present there never reaches parseMod -- which is why a gap in an
// upstream type table can be invisible upstream and still fatal here.
var degenTypesCompiled map[string]CompiledList[modNameListType]
var degenTypes = resourceTypesWithSuffix("Degen")

var costTypesCompiled map[string]CompiledList[modNameListType]
var costTypes = resourceTypesWithSuffix("Cost")

var baseCostTypesCompiled map[string]CompiledList[modNameListType]
var baseCostTypes = resourceTypesWithSuffix("CostNoMult")

// resourceTypes is ModParser.lua:5950-5976, which is TWO steps: the 16-row literal, and then
// the `do ... end` block at :5968-5976 that writes a "maximum "-prefixed copy of every row
// back into the same table. go-pob carried only the literal, so the whole table -- and every
// one of the four appendMod children derived from it -- was half its upstream size.
var resourceTypes = withMaximumResourceTypes(resourceTypesBase)

// withMaximumResourceTypes is ModParser.lua:5968-5976.
//
//pob:block:src/Modules/ModParser.lua:5968-5976
func withMaximumResourceTypes(base map[string][]string) map[string][]string {
	out := make(map[string][]string, len(base)*2)
	for line, names := range base {
		out[line] = names
		out["maximum "+line] = names
	}
	return out
}

//pob:block:src/Modules/ModParser.lua:5950-5967
var resourceTypesBase = map[string][]string{
	"life":                         {"Life"},
	"mana":                         {"Mana"},
	"energy shield":                {"EnergyShield"},
	"life and mana":                {"Life", "Mana"},
	"life and energy shield":       {"Life", "EnergyShield"},
	"life, mana and energy shield": {"Life", "Mana", "EnergyShield"},
	"life, energy shield and mana": {"Life", "Mana", "EnergyShield"},
	"mana and life":                {"Life", "Mana"},
	"mana and energy shield":       {"Mana", "EnergyShield"},
	"mana, life and energy shield": {"Life", "Mana", "EnergyShield"},
	"mana, energy shield and life": {"Life", "Mana", "EnergyShield"},
	"energy shield and life":       {"Life", "EnergyShield"},
	"energy shield and mana":       {"Mana", "EnergyShield"},
	"energy shield, life and mana": {"Life", "Mana", "EnergyShield"},
	"energy shield, mana and life": {"Life", "Mana", "EnergyShield"},
	"rage":                         {"Rage"},
}

//pob:src/Modules/ModParser.lua:5977-5990
func resourceTypesWithSuffix(suffix string) map[string]modNameListType {
	out := make(map[string]modNameListType, len(resourceTypes))
	for line, names := range resourceTypes {
		suffixed := make([]string, len(names))
		for i, n := range names {
			suffixed[i] = n + suffix
		}
		out[line] = modNameListType{names: suffixed}
	}

	return out
}

