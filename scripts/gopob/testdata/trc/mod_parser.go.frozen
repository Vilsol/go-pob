	// percentage, but only PercentStat matches what PoB's own modDB dump carries
	// (`type=PercentStat/percent=2/stat=Life`), which is what TestTagCensus compares.
	`recover (\d+)% of life on kill`: func(num float64, captures []string) ([]mod.Mod, string) {
