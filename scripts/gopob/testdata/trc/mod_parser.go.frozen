	// ModParser.lua:1520-1522. ⚠️ A PARTIALLY PORTED FAMILY: PoB has FOUR of these — cold, fire,
	// lightning and chaos — and we carried only chaos, so "+1% to Chaos Resistance per 1% Fire
	// Resistance" was dropped WHOLE on 349 of 3771 builds.
	//
	// Found by the OVER-APPLIED census, not by any missing-thing instrument: MissingChaosResist
	// ran 2.53x HIGH (our chaos resistance too LOW), and stat-overlap put ChaosResist,
	// ChaosResistTotal, MissingChaosResist and the three chaos TakenHitMult stats on essentially
	// ONE build set. Sampled builds had PoB at +71..+78 chaos resist against our NEGATIVE values.
	`per (\d+)% cold resistance`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "ColdResist")}
		},
	},
	`per (\d+)% fire resistance`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "FireResist")}
		},
	},
	`per (\d+)% lightning resistance`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "LightningResist")}
		},
	},
	`per (\d+)% cold resistance above 75%`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "ColdResistOver75")}
		},
	},
	`per (\d+)% lightning resistance above 75%`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "LightningResistOver75")}
		},
	},
	// ModParser.lua:1527. ⚠️ ANOTHER PARTIALLY PORTED FAMILY: the three per-element forms above
	// are here and the COMBINED one was not, so `10% increased Elemental Damage per 1% Fire,
	// Cold, or Lightning Resistance above 75%` was dropped whole on 242 builds. The producer
	// (calc_defence.go:337) and the PerStat machinery were already in place; PoB passes the three
	// stats as a statList, which our variadic PerStat takes directly.
	`per (\d+)% fire, cold, or lightning resistance above 75%`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]),
				"FireResistOver75", "ColdResistOver75", "LightningResistOver75")}
		},
	},
	`per (\d+) devotion`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "Devotion")}
		},
	},
	`per (\d+)% missing fire resistance, up to a maximum of (\d+)%`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "MissingFireResist").GlobalLimit(utils.Float(caps[1])).GlobalLimitKey("ReplicaNebulisFire")}
		},
	},
	`per (\d+)% missing cold resistance, up to a maximum of (\d+)%`: {
		fn: func(caps []string) modNameListType {
			return modNameListType{tag: mod.PerStat(utils.Float(caps[0]), "MissingColdResist").GlobalLimit(utils.Float(caps[1])).GlobalLimitKey("ReplicaNebulisCold")}
		},
	},
	`per endurance, frenzy or power charge`: {tag: mod.PerStat(0, "TotalCharges")},
	`per fortification`:                     {tag: mod.PerStat(0, "FortificationStacks")},
	// ModParser.lua:1535. ⚠️ THE CONSUMER AND THE PRODUCER BOTH EXISTED AND NOTHING JOINED THEM:
	// calc_perform.go:5448 writes FortificationStacksOver20 and no tag in this tree read it. Without
	// the row, "3% more Armour and Evasion Rating per Fortification above 20" (Champion's
	// Unstoppable Hero, tree node 33940) matched the shorter `per fortification` and left the
	// remainder " above 20 " — and an unparsed remainder discards the WHOLE line, so the node
	// contributed nothing at all and `task diag STEP=sources` reported Tree:33940 as a source we
	// never built. scan() prefers the LONGEST match, so this wins over the row above it exactly as
	// :1535 wins over :1533.
	`per fortification above 20`:       {tag: mod.PerStat(0, "FortificationStacksOver20")},
