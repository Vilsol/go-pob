	`^while a unique enemy is in your presence, `:                                 {tag: mod.ActorCondition("enemy", "RareOrUnique")},
	`^while a pinnacle atlas boss is in your presence, `:                          {tag: mod.ActorCondition("enemy", "PinnacleBoss")},
