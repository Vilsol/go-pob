	// ModParser.lua:4286-4288 — the Life Mastery effect. ⚠️ THE THRESHOLD IS captures[1], NOT
	// `num`; `num` is the MORE percentage. Getting them the wrong way round parses cleanly and
	// gates the mod on a threshold of 10 that no build reaches.
	`(\d+)% more maximum life if you have at least (\d+) life masteries allocated`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{
			MOD("Life", "MORE", num).Tag(mod.MultiplierThreshold("AllocatedLifeMastery").Threshold(utils.Float(captures[1]))),
		}, ""
	},
	// ModParser.lua:3449-3452 and :3453-3456 — the two resistance-conversion families
	// (Chieftain's Valako, Storm's Embrace and Tasalio, Cleansing Water). ⚠️ THE CAPTURED
	// ELEMENT NAMES ARE LOWERCASE HERE AND PoB UPPERCASES THE FIRST LETTER
	// (`resFrom:gsub("^%l", string.upper)`) before building the mod name, because the consumer
	// composes it from `resistTypeList`, which is capitalised.
	`modifiers to maximum (\w+) resistance also apply to maximum (\w+) and (\w+) resistances`: func(_ float64, captures []string) ([]mod.Mod, string) {
		from := capitaliseResistName(captures[0])
		return []mod.Mod{
			MOD(from+"MaxResConvertTo"+capitaliseResistName(captures[1]), "BASE", 100),
			MOD(from+"MaxResConvertTo"+capitaliseResistName(captures[2]), "BASE", 100),
		}, ""
	},
	// ⚠️ THE RATE IS captures[3], NOT `num`. `num` is the FIRST capture, which here is the element
	// NAME — it arrives as 0 and the first draft of this entry produced two conversion mods with a
	// rate of ZERO, i.e. present, parsed, and silently inert. Caught by the test REFUSING on an
	// empty activation population, not by the parse.
	`modifiers to (\w+) resistance also apply to (\w+) and (\w+) resistances at (\d+)% of their value`: func(_ float64, captures []string) ([]mod.Mod, string) {
		from := capitaliseResistName(captures[0])
		return []mod.Mod{
			MOD(from+"ResConvertTo"+capitaliseResistName(captures[1]), "BASE", utils.Float(captures[3])),
			MOD(from+"ResConvertTo"+capitaliseResistName(captures[2]), "BASE", utils.Float(captures[3])),
		}, ""
	},
