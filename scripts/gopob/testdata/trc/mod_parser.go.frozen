	// ModParser.lua:6102-6107 and :6111-6143 — the getSimpleConv radius family. ⚠️ EVERY UPSTREAM
	// ROW IS PARAMETERISED ON `(%d+)%%`; this port had them in the EXACT-STRING table, each frozen
	// at ONE literal percentage, so a jewel rolled at any other value matched nothing and the whole
	// line was discarded. The rows we happened to hold covered 45 corpus builds against ~592 for the
	// rows we dropped or never had — including 309 on `increased Maximum Life at 50%` alone.
	//
	// ⚠️ THE THREE POOL ROWS NEED `srcType`. They read a BASE resistance and emit an INC pool, which
	// is why they could not be expressed at all before getSimpleConvSrc existed.
	//
	// `Chance to Block Spells? ?D?a?m?a?g?e?` and `Chance to Dodge Attacks? ?H?i?t?s?` are the
	// upstream patterns verbatim: one row covers both the old and the current wording.
	{
		pattern: `passives granting lightning resistance or all elemental resistances in radius also grant chance to block spells? ?d?a?m?a?g?e? at (\d+)% of its value`,
		typ:     "Other",
