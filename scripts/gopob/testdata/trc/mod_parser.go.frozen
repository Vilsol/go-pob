	// ModParser.lua:2619 -- Ngamahu, Flame's Advance (Chieftain notable 50692), the ONLY producer
	// of an ExtraJewelFunc in the pinned data. 47 of 3771 corpus builds carry it and PoB writes
	// 2097 `Str BASE 4` rows for them, every one sourced at a JEWEL SOCKET node.
	//
	// ⚠️ IT IS TREE-SOURCED, SO A CORPUS GREP IS A LOWER BOUND AND RETURNS 0 -- the documented
	// inversion. It is also not enough to count builds allocating 50692 from `nodes="..."`: that
	// finds 16, because a Forbidden Flame/Flesh pair grants the notable to another class entirely
	// and the exemplar below is a JUGGERNAUT. Sized on PoB's side, from its own dumps.
	//
	// ⚠️ AND THE GUARD IS INLINE, NOT guardConquered. jewelFuncList's entries are wrapped at
	// table-build time (:6496-6513); these two carry their own `not node.conqueredBy` because
	// CalcSetup.lua:812-820 inserts them unwrapped.
	`non-unique jewels cause small and notable passive skills in a ([a-z]+) radius to also grant \+(\d+) to ([a-z]+)`: func(_ float64, captures []string) ([]mod.Mod, string) {
		// `firstToUpper(attr):match("^%a%l%l")` -- the first three letters of the title-cased
		// attribute name, so "strength" becomes "Str".
		attr := firstToUpper(captures[2])
		if len(attr) < 3 {
			return nil, ""
		}
		attr = attr[:3]
		value := utils.Float(captures[1])
		return []mod.Mod{
			mod.NewList("ExtraJewelFunc", extraJewelFuncEntry{
				Radius: firstToUpper(captures[0]),
				Type:   "Other",
				Func: func(node *radiusJewelNode, out *moddb.ModList, d *radiusJewelData) {
					if node == nil || node.conquered {
						return
					}
					if node.nodeType != "Notable" && node.nodeType != "Normal" {
						return
					}
					out.NewMod(attr, mod.TypeBase, value, d.modSource)
				},
			}).Tag(
				mod.ItemCondition("{SlotName}").Rarity("UNIQUE").Negate(true),
				mod.ItemCondition("{SlotName}").Rarity("RELIC").Negate(true),
			),
		}, ""
	},
