	// ⚠️ NEITHER OF THESE TWO CAN BE PORTED ALONE. Every roll count starts at 0, ExtremeLuck
	// DOUBLES it and Unexciting only fires when it is nonzero, so both are no-ops until a
	// roll-count flag has incremented it. All 18 ExtremeLuck builds and all 19 Unexciting builds
	// in the dumps carry one, and for the block path those flags are the rows above.
	"your lucky or unlucky effects use the best or worst from three rolls instead of two": []mod.Mod{mod.NewFlag("ExtremeLuck", true)},
	"your lucky or unlucky effects are instead unexciting":                                []mod.Mod{mod.NewFlag("Unexciting", true)},
	`prevent +(\+\d+)% of suppressed spell damage`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{mod.NewFloat("SpellSuppressionEffect", mod.TypeBase, num)}, ""
	},
	// ⚠️ DO NOT PORT CalcOffence.lua:718-724 ON TOP OF THIS ROW — IT WOULD DOUBLE-APPLY.
	// The pin implements this as a FLAG (ModParser.lua:3956, CritChanceIncreasedBySpellSuppress
	// Chance) plus a Tabulate consumer that writes `CritChance INC = output.SpellSuppressionChance`.
	// This row is the same arithmetic RE-ENCODED as a PerStat tag: evalPerStatTag computes
	// floor(SpellSuppressionChance/1) and multiplies the value 1 by it. Both read the same stat,
	// and CalculateDefence writes it before CalculateOffence on both sides.
	//
	// A census of mod ROWS cannot tell a re-encoding from a missing mod, which is why this was
	// briefed as an unported block twice — once by an operator and once by a truncated grep of
	// this very file.
	//
	// ⚠️ THE ONE REAL DIVERGENCE IS THE FLOOR: PerStat floors, PoB's NewMod does not, so a
	// fractional suppression chance rounds down here. RETIRING CONDITION: the producing line is on
	// 0 of 8648 corpus builds, so nothing can grade it — revisit if corpus-grep for
	// "increased by Chance to Suppress Spell Damage" ever returns > 0, and replace this row with
	// the flag/consumer pair rather than adding one beside it.
	"critical strike chance is increased by chance to suppress spell damage": []mod.Mod{MOD("CritChance", "INC", 1).Tag(mod.PerStat(1, "SpellSuppressionChance"))},
	`you take (\d+)% reduced extra damage from suppressed critical strikes`: func(num float64, captures []string) ([]mod.Mod, string) {
		return []mod.Mod{mod.NewFloat("ReduceSuppressedCritExtraDamage", mod.TypeBase, num)}, ""
	},
	`\+(\d+)% chance to suppress spell damage if your boots, helmet and gloves have evasion`: func(num float64, captures []string) ([]mod.Mod, string) {
		// PoB writes `uppper = true` on the helmet/gloves thresholds (ModParser.lua:2495-2496),
		// a typo that never reaches StatThreshold, so all three are lower bounds. Do not "fix".
		return []mod.Mod{
			MOD("SpellSuppressionChance", "BASE", num).
				Tag(mod.StatThreshold("EvasionOnBoots", 1)).
				Tag(mod.StatThreshold("EvasionOnHelmet", 1)).
				Tag(mod.StatThreshold("EvasionOnGloves", 1)),
		}, ""
	},
