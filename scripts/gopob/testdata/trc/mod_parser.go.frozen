// List of modifier forms
// addToClusterRe matches the cluster-jewel enchant that grants extra mods to every
// small passive in the jewel's radius: "Added Small Passive Skills also grant: <mods>".
var addToClusterRe = regexp.MustCompile(`^Added Small Passive Skills also grant: (.+)$`)

var formListCompiled map[string]CompiledList[string]
var formList = map[string]string{
	`^(\d+)% increased`:              "INC",
	`^(\d+)% faster`:                 "INC",
	`^(\d+)% reduced`:                "RED",
	`^(\d+)% slower`:                 "RED",
	`^(\d+)% more`:                   "MORE",
	`^(\d+)% less`:                   "LESS",
	`^([\+\-][\d\.]+)%?`:             "BASE",
	`^([\+\-][\d\.]+)%? to`:          "BASE",
	`^([\+\-]?[\d\.]+)%? of`:         "BASE",
	`^([\+\-][\d\.]+)%? base`:        "BASE",
	`^([\+\-]?[\d\.]+)%? additional`: "BASE",
	`(\d+) additional hits?`:         "BASE",
	`^you gain ([\d\.]+)`:            "BASE",
	`^gains? ([\d\.]+)% of`:          "BASE",
	// ModParser.lua:55 — `["^gain ([%d%.]+)"] = "GAIN"`, and :4656-4658 makes GAIN behave exactly
	// like BASE (modType = "BASE", then the same suffixTypes scan), which is why it maps to "BASE"
	// here as `^you gain` already does. Its absence left every "Gain N <stat> per Enemy Killed"
	// tree node unparsed — `Tree:25058 (Blood Siphon)` alone is 1076 corpus builds.
	`^gain ([\d\.]+)`: "BASE",
	// ⚠️ THE `GAIN`/`LOSE` FAMILIES ARE SYMMETRIC UPSTREAM AND ONLY ONE HALF WAS HERE.
	// ModParser.lua:87-94 lists four GAIN rows and four LOSE rows; :6715-6717 makes LOSE a
	// NEGATED BASE and then runs the same suffix scan. Missing them dropped every "Lose N ..."
	// line WHOLE, since processModLine discards anything with leftover Extra.
	//pob:block:src/Modules/ModParser.lua:87-94
	`^gain \+(\d+)% to`:     "BASE",
	`^you lose ([\d\.]+)`:   "LOSE",
	`^loses? ([\d\.]+)% of`: "LOSE",
	`^lose ([\d\.]+)`:       "LOSE",
	`^lose \+(\d+)% to`:     "LOSE",
	// :24-25. GRANTS and REMOVES are LOCAL forms -- both carry a `{Hand}Attack` condition
	// upstream, so porting the row without the tag would apply a weapon-local grant globally.
	// That is the over-application shape `task overapplied-census` exists for, and porting the
	// absence is as much a part of the port as porting the value.
	//pob:block:src/Modules/ModParser.lua:95-96
	`^grants ([\d\.]+)`:                   "GRANTS",
	`^removes? ([\d\.]+) ?o?f? ?y?o?u?r?`: "REMOVES",
	// ⚠️ :154's OVERRIDE row. THE REASON THIS WAS NOT PORTED HAD EXPIRED: the note said it PANICS
	// (nil deref) on "Base Critical Strike Chance for Spells is 10%" because the pattern is
	// UNANCHORED and reaches code assuming a leading match. Re-measured, it does not — and three
	// unanchored DOUBLED rows have since landed in this same table, which is what says the scan
	// machinery handles them now.
	//
	// ⚠️ WHAT THE NOTE GOT RIGHT IS THAT THE ROW IS NOT FREE. Without the OVERRIDE arm in the form
	// switch, modType stays "BASE" and every carrier becomes a WRONG mod rather than a dropped one
	// -- measured while porting it: "Chaos Resistance is 0" came out `ChaosResist BASE 0`. Read the
	// value as evidence and the prose as hypothesis: the symptom moved, the hazard did not.
	//
	// It recovers ONE line family, `Chaos Resistance is 0` (63 corpus occurrences). The three
	// biggest OVERRIDE-shaped lines -- Movement Speed 150% (85 builds), Crit Multi 300% (39), Fire
	// Resistance 75% (3) -- already parse through hand-written specialModList rows, which is scanned
	// first and returns early, so the form cannot shadow them.
	// :85-86, :97. Three form rows that were missing, and the last is the important one.
	//
	// ⚠️ `^(\d+)` IS A BARE LEADING NUMBER WITH NO SIGN, and its absence meant a line had to start
	// with `+` or `-` to be read as a BASE at all. "+48 Life gained when you Block" parsed and
	// "48 Life gained when you Block" did NOT — the mod name was in the list, the value was right
	// there, and the whole line was discarded for want of a plus. Every such line in the corpus is
	// written without the sign.
	//
	// ⚠️ IT IS SAFE ONLY BECAUSE THE SCAN IS LONGEST-MATCH. `^(\d+)% increased` and the rest all
	// match the same span and are longer, so they still win the tie-break in scanState.consider —
	// this row can only catch what nothing else claims.
	`(\d+) additional times?`: "BASE",
	`^throw up to (\d+)`:      "BASE",
	`^(\d+)`:                  "BASE",
	`^([\+\-]?\d+)% chance`:   "CHANCE",
	// ⚠️ A **MORE SPECIFIC** SIBLING OF THE ROW ABOVE, AND ITS ABSENCE READ AS COVERAGE. Without
	// it every "N% chance to gain <X>" line matched the shorter `N% chance` form, consumed the
	// number, and then found no mod name for the rest -- so the line was dropped WHOLE. The drop
	// censuses show the leftovers directly: "to gain  for 4 seconds on Kill", "to gain an
	// Endurance Charge on Kill", "to gain  when you Kill an Enemy". Both ends of the feature were
	// already here: the FLAG handler, and a flagTypes table measured at 37 keys against the pin's
	// 37. Only this row was missing.
	//pob:src/Modules/ModParser.lua:99
	`^([\+\-]?\d+)% chance to gain `:   "FLAG",
	`^([\+\-]?\d+)% additional chance`: "CHANCE",
	`penetrates? (\d+)%`:               "PEN",
	`penetrates (\d+)% of`:             "PEN",
	`penetrates (\d+)% of enemy`:       "PEN",
	//pob:src/Modules/ModParser.lua:59-66
	// One Go pattern per Lua pattern, in the Lua's order: the
	// forms differ only by the "of" / "of your" prefix, and scan()'s longest-pattern
	// tie-break is what picks between them, so collapsing them into an alternation
	// loses the bare form. The pool is captured with (.+)/(.+?) — Lua's (.+)/(.-) —
	// because regenTypes' keys are multi-word ("energy shield", "maximum life",
	// "maximum mana and energy shield"); a \S-based capture cannot reach any of them.
	`^([\d\.]+) (.+) regenerated per second`:          "REGENFLAT",
	`^([\d\.]+)% (.+) regenerated per second`:         "REGENPERCENT",
	`^([\d\.]+)% of (.+) regenerated per second`:      "REGENPERCENT",
	`^regenerate ([\d\.]+) (.+) per second`:           "REGENFLAT",
	`^regenerate ([\d\.]+)% (.+?) per second`:         "REGENPERCENT",
	`^regenerate ([\d\.]+)% of (.+?) per second`:      "REGENPERCENT",
	`^regenerate ([\d\.]+)% of your (.+?) per second`: "REGENPERCENT",
	`^you regenerate ([\d\.]+)% of (.+) per second`:   "REGENPERCENT",
	`^([\d\.]+) (\w+) damage taken per second`:        "DEGEN",
	`^([\d\.]+) (\w+) damage per second`:              "DEGEN",
	// ModParser.lua:114-121. These share their opening with the LOSE rows above and win
	// because scan prefers the LONGER match at the same start index.
	`^([\d\.]+) (.+) lost per second`:           "DEGENFLAT",
	`^([\d\.]+)% (.+) lost per second`:          "DEGENPERCENT",
	`^([\d\.]+)% of (.+) lost per second`:       "DEGENPERCENT",
	`^lose ([\d\.]+) (.+?) per second`:          "DEGENFLAT",
	`^lose ([\d\.]+)% (.+?) per second`:         "DEGENPERCENT",
	`^lose ([\d\.]+)% of (.+?) per second`:      "DEGENPERCENT",
	`^lose ([\d\.]+)% of your (.+?) per second`: "DEGENPERCENT",
	`^you lose ([\d\.]+)% of (.+) per second`:   "DEGENPERCENT",
	// :101-102. UNANCHORED upstream, so a numeric form earlier in the line still wins.
	`costs? ([\+\-]?\d+)`:                                    "TOTALCOST",
	`skills cost ([\+\-]?\d+)`:                               "BASECOST",
	`(\d+) to (\d+) added (\w+) damage`:                      "DMG",
	`(\d+)\-(\d+) added (\w+) damage`:                        "DMG",
	`(\d+) to (\d+) additional (\w+) damage`:                 "DMG",
	`(\d+)\-(\d+) additional (\w+) damage`:                   "DMG",
	`^(\d+) to (\d+) (\w+) damage`:                           "DMG",
	`adds (\d+) to (\d+) (\w+) damage`:                       "DMG",
	`adds (\d+)\-(\d+) (\w+) damage`:                         "DMG",
	`adds (\d+) to (\d+) (\w+) damage to attacks`:            "DMGATTACKS",
	`adds (\d+)\-(\d+) (\w+) damage to attacks`:              "DMGATTACKS",
	`adds (\d+) to (\d+) (\w+) attack damage`:                "DMGATTACKS",
	`adds (\d+)\-(\d+) (\w+) attack damage`:                  "DMGATTACKS",
	`(\d+) to (\d+) added attack (\w+) damage`:               "DMGATTACKS",
	`adds (\d+) to (\d+) (\w+) damage to spells`:             "DMGSPELLS",
	`adds (\d+)\-(\d+) (\w+) damage to spells`:               "DMGSPELLS",
	`adds (\d+) to (\d+) (\w+) spell damage`:                 "DMGSPELLS",
	`adds (\d+)\-(\d+) (\w+) spell damage`:                   "DMGSPELLS",
	`(\d+) to (\d+) added spell (\w+) damage`:                "DMGSPELLS",
	`adds (\d+) to (\d+) (\w+) damage to attacks and spells`: "DMGBOTH",
	`adds (\d+)\-(\d+) (\w+) damage to attacks and spells`:   "DMGBOTH",
	`adds (\d+) to (\d+) (\w+) damage to spells and attacks`: "DMGBOTH", // o_O
	`adds (\d+)\-(\d+) (\w+) damage to spells and attacks`:   "DMGBOTH", // o_O
	`adds (\d+) to (\d+) (\w+) damage to hits`:               "DMGBOTH",
	`adds (\d+)\-(\d+) (\w+) damage to hits`:                 "DMGBOTH",
	`^you have `:                                             "FLAG",
	`^you are `:                                              "FLAG",
	`^are `:                                                  "FLAG",
	// ModParser.lua:155-157. UNANCHORED on purpose: scan takes the EARLIEST match, so any
	// numeric form earlier in the line still wins and only a line no other form matches can
	// reach these. `is doubled` beats `doubles?` on the same line for the same reason.
	`is (-?\d+)%? `:  "OVERRIDE",
	`is doubled`:     "DOUBLED",
	`doubles?`:       "DOUBLED",
	`causes? double`: "DOUBLED",
}

type modNameListType struct {
	names          []string
	tag            mod.Tag
	tagList        []mod.Tag
	flags          mod.MFlag
	addToMinion    bool
	keywordFlags   mod.KeywordFlag
	addToSkill     mod.Tag
	addToMinionTag mod.Tag

	// playerTag is ModParser.lua:6895 and :6912. It is NOT addToMinionTag: addToMinionTag says
	// WHICH minion the mod reaches, playerTag is a condition on the PLAYER that gates whether it
	// reaches any of them, and both can appear on one row. It is read in the addToMinion and
	// applyToEnemy branches only -- the two places upstream reads it.
	//
	// playerTagList (:6897, :6913) is deliberately not carried: its only two producers upstream
	// are the enemies-you-have-hit-recently rows, which are 0 of 8649 corpus builds. Retiring
	// condition: port it with those rows if either ever appears.
	playerTag    mod.Tag
	applyToEnemy bool
	fn           func(caps []string) modNameListType
	modSuffix    string
	addToAura    bool
	// onlyAddToBanners is ModParser.lua:6871-6874: the addToAura wrapper additionally carries a
	// Banner SkillType tag, so the effect reaches banners alone rather than every aura. Its one
	// producer is the `^banners also grant ` prefix (:1291), which was declared unported here
	// with the reason "this struct does not have the field" -- a reason that retires the moment
	// the field and its consumer land together, which is this commit.
	onlyAddToBanners  bool
	newAuraOnlyAllies bool
	newAura           bool

	// flagModType and flagModValue are PoB's TABLE-valued flagTypes entry
	// (ModParser.lua:3568), consumed at :4137-4141: a FLAG form whose entry is a table builds
	// the mod that table DESCRIBES -- `{name, type, value}` -- instead of the usual
	// `<name> FLAG true`. An empty flagModType means the ordinary boolean form.
	flagModType  string
	flagModValue float64
}

