	// ModParser.lua:2141-2153. The catch-all under the fifteen hard-coded phrases above; the
	// scan's longest-pattern tie-break keeps those winning where they apply. "+1 to Level of
	// all Skill Gems" (Ashes of the Stars) reaches only this one, and matched nothing at all
	// while it was unported.
	`\+(\d+) to level of all (.+) gems`: func(num float64, captures []string) ([]mod.Mod, string) {
		skill := strings.ToLower(captures[1])
		if _, known := gemLookup().skillIDForName[skill]; known {
			return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{Keyword: utils.Ptr(skill), Key: "level", Value: num})}, ""
		}

		// Lua's `skill:gmatch("%w+")`.
		wordList := gemKeywordWordPattern.FindAllString(skill, -1)
		for i, tag := range wordList {
			if tag == "skill" {
				wordList[i] = "active_skill"
			}
		}

		return []mod.Mod{MOD("GemProperty", "LIST", mod.GemProperty{KeywordList: wordList, Key: "level", Value: num})}, ""
	},
	// Extra skill/support
