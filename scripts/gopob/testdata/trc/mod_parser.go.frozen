	// ModParser.lua:3366-3380. PoB keys this whole family `immun[ei]t?y? to <x> during
	// f?l?a?s?k? ?effect`, and go-pob carried six EXACT LITERALS plus two missing rows.
	//
	// ⚠️ THE `flask` IS OPTIONAL UPSTREAM AND THAT IS WHAT THE REAL ITEM TEXT USES. Measured
	// with `task corpus-grep` over the 6105-build 3.20 corpus — the "Flask Effect" spelling our
	// literals required is the RARE one, by ten to twenty times:
	//
	//	                                 "during Effect"   "during Flask Effect"
	//	bleeding and corrupted blood            606                    19
	//	freeze and chill                        410                    28
	//	ignite                                  277                    25
	//	poison                                  252                    12
	//	shock                                   130                     8
	//
	// So this is not two missing rows — it is two missing rows and six that could not match
	// most of their population. `Immunety`/`immunit` measure 0 of 6105, but the omitted `flask`
	// does not, and the same pattern covers both.
	//
	// Like every Avoid* rule around it, PoB's `{ type = "GlobalEffect", effectType = "Global",
	// unscalable = true }` is not carried; that omission is family-wide and predates this.
	`immun[ei]t?y? to shock during f?l?a?s?k? ?effect`:    []mod.Mod{FLAG("ShockImmune").Tag(mod.Condition("UsingFlask"))},
	`immun[ei]t?y? to ignite during f?l?a?s?k? ?effect`:   []mod.Mod{FLAG("IgniteImmune").Tag(mod.Condition("UsingFlask"))},
	`immun[ei]t?y? to poison during f?l?a?s?k? ?effect`:   []mod.Mod{FLAG("PoisonImmune").Tag(mod.Condition("UsingFlask"))},
	`immun[ei]t?y? to curses during f?l?a?s?k? ?effect`:   []mod.Mod{FLAG("CurseImmune").Tag(mod.Condition("UsingFlask"))},
	`immun[ei]t?y? to bleeding during f?l?a?s?k? ?effect`: []mod.Mod{FLAG("BleedImmune").Tag(mod.Condition("UsingFlask"))},
	// ⚠️ THE PIN EMITS TWO MODS HERE (ModParser.lua:4867-4870) and this row carried one: the
	// `CorruptedBloodImmune` half was silently dropped, which no missing-producer census can see
